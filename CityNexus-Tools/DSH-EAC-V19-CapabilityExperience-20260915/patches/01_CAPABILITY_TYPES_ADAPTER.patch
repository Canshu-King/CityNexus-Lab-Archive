+/* CityNexus V19 capability experience. Prefix cne- to avoid collisions. */
+:root {
+  --cne-ink: #102a30;
+  --cne-muted: #53666b;
+  --cne-line: #c9d6d3;
+  --cne-panel: #ffffff;
