+.cne-source-notice { color: var(--cne-muted); font-size: 0.82rem; }
+.cne-sr-only {
+  position: absolute !important;
+  width: 1px; height: 1px; padding: 0; margin: -1px;
+  overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
+}
+
+.cne-button {
+  min-height: var(--cne-target);
+  min-width: var(--cne-target);
+  padding: 0.68rem 0.95rem;
+  border-radius: 12px;
+  border: 1px solid transparent;
+  font-weight: 750;
+  cursor: pointer;
+  touch-action: manipulation;
+}
+.cne-button:focus-visible,
+.cne-chip:focus-visible,
+.cne-disclosure:focus-visible,
+.cne-map-marker:focus-visible,
+.cne-evidence:focus-visible {
+  outline: 3px solid var(--cne-focus);
+  outline-offset: 2px;
+}
+.cne-button--primary { background: var(--cne-brand); color: #fff; }
+.cne-button--secondary { background: #e8f1ef; color: var(--cne-brand-strong); border-color: #b9d2cd; }
