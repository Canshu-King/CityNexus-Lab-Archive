+  color: var(--cne-ink);
+  font: inherit;
+}
+
+.cne-kicker {
+  display: inline-block;
+  font-size: 0.72rem;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--cne-brand);
+}
+
+.cne-help { color: var(--cne-muted); font-size: 0.88rem; line-height: 1.45; }
