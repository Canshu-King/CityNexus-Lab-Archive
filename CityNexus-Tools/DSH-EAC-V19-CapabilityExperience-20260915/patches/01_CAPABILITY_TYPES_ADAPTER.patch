+.cne-button:disabled { opacity: 0.55; cursor: not-allowed; }
+.cne-surface__actions { display: flex; gap: 0.6rem; justify-content: flex-end; flex-wrap: wrap; }
+.cne-surface__actions--wrap { flex-wrap: wrap; }
+.cne-surface__head { display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
+.cne-surface__head h2 { margin: 0.15rem 0; font-size: clamp(1.1rem, 2vw, 1.35rem); }
+.cne-surface__head p { margin: 0.2rem 0; color: var(--cne-muted); }
+
