+import { useEffect, useMemo, useRef, useState } from "react";
+import { useT } from "../i18n";
+import { prefersReducedMotion } from "../motion";
+import { testIds } from "../testids";
+import type {
+  AgentRunEvent,
+  AgentRunFixture,
+  ApprovalState,
+  DataSource,
+  RuntimeIdentity,
+  TimelineStep,
+  TimelineStepStatus,
+} from "../types";
+import { RuntimeTruthBadge } from "./RuntimeTruthBadge";
+
+const HUMAN_TOOL: Record<string, string> = {
+  inspect_journey: "journey",
+  inspect_twin: "protected commitments",
+  search_city_services: "alternatives",
+  request_replan: "replan",
+};
+
+const TOOL_LABELS: Record<string, { started: string; done: string }> = {
+  inspect_journey: { started: "Checking Journey", done: "Checked Journey" },
+  inspect_twin: { started: "Checking protected commitments", done: "Checked protected commitments" },
+  search_city_services: { started: "Searching alternatives", done: "Searched alternatives" },
+  request_replan: { started: "Requesting replan", done: "Requested replan" },
+};
+
+function humanTool(toolName?: string): string {
+  if (!toolName) return "tool";
+  return HUMAN_TOOL[toolName] ?? toolName;
+}
+
+export function statusForEvent(event: AgentRunEvent): TimelineStepStatus {
+  switch (event.event_type) {
+    case "tool.started":
+      return "active";
+    case "tool.failed":
+    case "run.failed":
+      return "failed";
+    case "approval.required":
+      return "approval";
+    case "run.stopped":
+      return "stopped";
+    default:
+      return "done";
+  }
+}
+
+export function labelForEvent(event: AgentRunEvent): string {
+  const tool = humanTool(event.tool_name);
+  switch (event.event_type) {
+    case "semantic.interpreted":
+      return "Understood request";
+    case "mission.planned":
+      return "Mission planned";
+    case "run.started":
+      return "Run started";
+    case "tool.started":
+      return TOOL_LABELS[event.tool_name ?? ""]?.started ?? `Started · ${tool}`;
+    case "tool.completed":
+      return TOOL_LABELS[event.tool_name ?? ""]?.done ?? `Completed · ${tool}`;
+    case "tool.failed":
+      return `Failed · ${tool}`;
+    case "gateway.checked":
+      return "Gateway checked";
+    case "guardian.checked":
+      return "Guardian checked";
+    case "proposal.created":
+      return "Proposal created";
+    case "approval.required":
+      return "Waiting for approval";
+    case "run.completed":
+      return "Run completed";
+    case "run.failed":
+      return "Run failed";
+    case "run.stopped":
+      return "Run stopped";
+    default:
+      return tool;
+  }
+}
+
+export function deriveTimelineSteps(events: AgentRunEvent[]): TimelineStep[] {
+  return events.map((event) => ({
+    id: event.id,
+    event_type: event.event_type,
+    label: labelForEvent(event),
+    toolName: event.tool_name,
+    status: statusForEvent(event),
+    timestamp: event.timestamp,
+    summary: event.summary,
+    source: event.source,
+    duration_ms: event.duration_ms,
+  }));
+}
+
+function runStatusFor(events: AgentRunEvent[], stoppedLocally: boolean): string {
+  if (stoppedLocally) return "stopped";
+  const last = events[events.length - 1];
+  if (!last) return "idle";
+  if (last.event_type === "run.failed" || last.event_type === "tool.failed") return "failed";
+  if (last.event_type === "run.stopped") return "stopped";
+  if (last.event_type === "approval.required" || last.run_status === "approval_required") return "approval_required";
+  if (last.event_type === "run.completed" || last.run_status === "success") return "success";
+  return "running";
+}
+
+export function AgentRunTimeline({
+  fixture,
+  liveEventsUrl,
+  liveEvents,
+  onStop,
+  onApproval,
+  compact = false,
+}: {
+  fixture?: AgentRunFixture;
+  liveEventsUrl?: string;
+  liveEvents?: AgentRunEvent[];
+  onStop?: () => void;
+  onApproval?: (state: ApprovalState) => void;
+  compact?: boolean;
+}) {
+  const t = useT();
+  const isLive = Boolean(liveEventsUrl || (liveEvents && liveEvents.length > 0));
+  const sourceEvents = useMemo<AgentRunEvent[]>(
+    () => liveEvents ?? fixture?.events ?? [],
+    [liveEvents, fixture],
+  );
+  const [visibleCount, setVisibleCount] = useState(isLive ? sourceEvents.length : 0);
+  const [replaying, setReplaying] = useState(false);
+  const [replayStopped, setReplayStopped] = useState(false);
+  const [expanded, setExpanded] = useState(!compact);
+  const [approvalState, setApprovalState] = useState<ApprovalState>("proposal_only");
+  const frameRef = useRef<number | null>(null);
+  const lastAdvanceRef = useRef<number>(0);
+
+  useEffect(() => {
+    setVisibleCount(isLive ? sourceEvents.length : 0);
+    setReplaying(false);
+    setReplayStopped(false);
+    setApprovalState("proposal_only");
+  }, [fixture?.run_id, isLive, sourceEvents.length]);
+
+  useEffect(() => {
+    if (!replaying) {
+      if (frameRef.current != null) cancelAnimationFrame(frameRef.current);
+      frameRef.current = null;
+      return undefined;
+    }
+    const total = sourceEvents.length;
+    const step = (now: number) => {
+      if (visibleCount >= total) {
+        setReplaying(false);
+        return;
+      }
+      const currentEvent = sourceEvents[Math.max(0, visibleCount - 1)];
+      const nextEvent = sourceEvents[visibleCount];
+      const recordedGap = currentEvent
+        ? Math.max(120, Math.min(900, Date.parse(nextEvent.timestamp) - Date.parse(currentEvent.timestamp)))
+        : 120;
+      if (now - lastAdvanceRef.current >= recordedGap) {
+        lastAdvanceRef.current = now;
+        setVisibleCount((count) => Math.min(total, count + 1));
+      }
+      frameRef.current = requestAnimationFrame(step);
+    };
+    lastAdvanceRef.current = performance.now();
+    frameRef.current = requestAnimationFrame(step);
+    return () => {
+      if (frameRef.current != null) cancelAnimationFrame(frameRef.current);
+      frameRef.current = null;
+    };
+  }, [replaying, sourceEvents, visibleCount]);
+
+  const visibleEvents = sourceEvents.slice(0, visibleCount);
+  const steps = deriveTimelineSteps(visibleEvents);
+  const currentStep = steps[steps.length - 1];
+  const source: DataSource = isLive ? "LIVE" : fixture?.fixture_label ?? "RECORDED_FIXTURE";
+  const runtimeIdentity: RuntimeIdentity = isLive ? "HERMES_NATIVE_MCP" : fixture?.runtime_identity ?? "HERMES_NATIVE_MCP";
+  const runStatus = runStatusFor(visibleEvents, replayStopped);
+  const statusLabel = t(`timeline.run.${runStatus}`);
+
+  const startReplay = () => {
+    if (prefersReducedMotion()) {
+      setVisibleCount(sourceEvents.length);
+      setReplaying(false);
+      return;
+    }
+    setReplayStopped(false);
+    setVisibleCount((count) => (count >= sourceEvents.length ? 0 : count));
+    setReplaying(true);
+  };
+
+  const stopReplay = () => {
+    setReplaying(false);
+    setReplayStopped(true);
+    onStop?.();
+  };
+
+  const decide = (state: ApprovalState) => {
+    setApprovalState(state);
+    onApproval?.(state);
+  };
+
+  return (
+    <section
+      className={`timeline timeline--${runStatus}`}
+      data-testid={testIds.agentRunTimeline}
+      data-source={source}
+      data-run-status={runStatus}
+      aria-live="polite"
+    >
+      <header className="timeline__head">
+        <div>
+          <span className="kicker">{t("timeline.kicker")}</span>
+          <h3>{t("timeline.title")}</h3>
+        </div>
+        <RuntimeTruthBadge
+          truth={{ semantic: "DeepSeek", execution: runtimeIdentity, truth: "CityNexus", source, status: "ready" }}
+          compact
+        />
+      </header>
+      {source === "RECORDED_FIXTURE" && (
+        <p className="fixture-banner" data-testid={testIds.timelineSource}>
+          <b>{t("timeline.recorded")}</b> · {t("timeline.recordedNote")}
+        </p>
+      )}
+      <div className="timeline__summary" data-testid="timeline-summary" data-status={runStatus}>
+        <b>{statusLabel}</b>
+        {currentStep && currentStep.label !== statusLabel && (
+          <span>
+            {currentStep.label}
+            {currentStep.toolName ? ` · ${humanTool(currentStep.toolName)}` : ""}
+            {currentStep.duration_ms ? ` · ${currentStep.duration_ms}ms` : ""}
+          </span>
+        )}
+      </div>
+      {replayStopped && (
+        <p className="fixture-banner stopped" role="status">
+          {t("timeline.stoppedLocally")}
+        </p>
+      )}
+      {compact && !expanded ? (
+        <button
+          type="button"
+          className="btn"
+          data-testid="timeline-expand"
+          onClick={() => setExpanded(true)}
+        >
+          {t("timeline.expand")}
+        </button>
+      ) : (
+        <>
+          {steps.length === 0 ? (
+            <p className="muted">{t("timeline.empty")}</p>
+          ) : (
+            <ol className="timeline__steps">
+              {steps.map((step) => (
+                <li
+                  key={step.id}
+                  className={`timeline-step ${step.status}`}
+                  data-testid={testIds.timelineStep}
+                  data-status={step.status}
+                  data-tool={step.toolName ?? ""}
+                >
+                  <span className="timeline-step__mark" aria-hidden="true" />
+                  <div className="timeline-step__body">
+                    <b>{step.label}</b>
+                    {step.toolName && (
+                      <code className="timeline-step__tool" title={step.toolName}>
+                        {step.toolName}
+                        {step.duration_ms ? ` · ${step.duration_ms}ms` : ""}
+                      </code>
+                    )}
+                    <small>{step.summary}</small>
+                    <time dateTime={step.timestamp}>{step.timestamp.slice(11, 23)}</time>
+                  </div>
+                  <span className="timeline-step__status">{t(`timeline.status.${step.status}`)}</span>
+                </li>
+              ))}
+            </ol>
+          )}
+          {compact && (
+            <button type="button" className="btn" data-testid="timeline-collapse" onClick={() => setExpanded(false)}>
+              {t("timeline.collapse")}
+            </button>
+          )}
+        </>
+      )}
+      {visibleEvents.some((item) => item.event_type === "proposal.created") && (
+        <div className="proposal-summary" data-testid="proposal-summary">
+          <b>{t("approval.proposal")}</b>
+          <p>{t("approval.proposalDetail")}</p>
+        </div>
+      )}
+      {steps.some((step) => step.status === "approval") && (
+        <div
+          className="approval-panel"
+          data-testid="approval-panel"
+          data-approval-state={approvalState}
+          role="group"
+          aria-label={t("approval.title")}
+        >
+          <div>
+            <b>{t("approval.title")}</b>
+            <p>{t("approval.impact")}</p>
+          </div>
+          <div className="approval-actions">
+            <button
+              type="button"
+              className="btn btn--approve"
+              data-testid="approval-approve"
+              onClick={() => decide("approved")}
+            >
+              {t("approval.approve")}
+            </button>
+            <button
+              type="button"
+              className="btn btn--reject"
+              data-testid="approval-reject"
+              onClick={() => decide("rejected")}
+            >
+              {t("approval.reject")}
+            </button>
+            <button type="button" className="btn" data-testid="approval-review" onClick={() => decide("review_requested")}>
+              {t("approval.review")}
+            </button>
+          </div>
+          <p className="muted small" data-testid="approval-state-copy">
+            {t(`approval.state.${approvalState}`)} · {t("approval.authority")}
+          </p>
+        </div>
+      )}
+      <div className="timeline__controls">
+        <button
+          type="button"
+          className="btn"
+          data-testid={testIds.timelinePrev}
+          onClick={() => {
+            setReplaying(false);
+            setVisibleCount((count) => Math.max(0, count - 1));
+          }}
+          disabled={visibleCount === 0}
+        >
+          {t("timeline.previous")}
+        </button>
+        <button
+          type="button"
+          className="btn"
+          data-testid={testIds.timelineNext}
+          onClick={() => {
+            setReplaying(false);
+            setVisibleCount((count) => Math.min(sourceEvents.length, count + 1));
+          }}
+          disabled={visibleCount >= sourceEvents.length}
+        >
+          {t("timeline.next")}
+        </button>
+        <button type="button" className="btn btn--primary" data-testid={testIds.timelineReplay} onClick={startReplay}>
+          {replaying ? t("timeline.pause") : t("timeline.replay")}
+        </button>
+        {!isLive && (
+          <button type="button" className="btn" data-testid={testIds.timelineStop} onClick={stopReplay}>
+            {t("timeline.stop")}
+          </button>
+        )}
+      </div>
+      <p className="muted small" data-testid="timeline-count">
+        {t("timeline.eventCount", { visible: visibleCount, total: sourceEvents.length })}
+      </p>
+    </section>
+  );
+}
diff --git a/frontend/src/features/experience-lab/components/CopilotDock.tsx b/frontend/src/features/experience-lab/components/CopilotDock.tsx
new file mode 100644
--- /dev/null	2026-09-15 01:54:21.000000000 +0800
+++ b/frontend/src/features/experience-lab/components/CopilotDock.tsx
@@ -0,0 +1,390 @@
+import { useEffect, useMemo, useRef, useState, type ChangeEvent, type FormEvent } from "react";
+import { useT } from "../i18n";
+import { testIds } from "../testids";
+import type { AgentRunFixture, CopilotMessage, RuntimeTruth } from "../types";
+import { HERMES_FIXTURES, HERMES_RECORDED_RUN, type HermesFixtureKey } from "../data/hermesFixture";
+import { AgentRunTimeline } from "./AgentRunTimeline";
+import { RuntimeStatusBanner, RuntimeTruthBadge } from "./RuntimeTruthBadge";
+
+const DIRECT_TRUTH: RuntimeTruth = {
+  semantic: "DeepSeek",
+  execution: "DIRECT",
+  truth: "CityNexus",
+  source: "RECORDED_FIXTURE",
+  status: "ready",
+};
+
+const HERMES_TRUTH: RuntimeTruth = {
+  semantic: "DeepSeek",
+  execution: "HERMES_NATIVE_MCP",
+  truth: "CityNexus",
+  source: "RECORDED_FIXTURE",
+  status: "ready",
+};
+
+const FALLBACK_TRUTH: RuntimeTruth = {
+  semantic: "DeepSeek",
+  execution: "FALLBACK",
+  truth: "CityNexus",
+  source: "RECORDED_FIXTURE",
+  status: "deepseek_unavailable",
+};
+
+const UNAVAILABLE_TRUTH: RuntimeTruth = {
+  semantic: "DeepSeek",
+  execution: "UNAVAILABLE",
+  truth: "CityNexus",
+  source: "RECORDED_FIXTURE",
+  status: "hermes_unavailable",
+};
+
+let messageSeq = 0;
+function nextMessageId(): string {
+  messageSeq += 1;
+  return `copilot-message-${messageSeq}`;
+}
+
+export function CopilotDock({
+  open,
+  onOpenChange,
+  onNavigate,
+  activeFixture,
+  onFixtureChange,
+  isMobile,
+}: {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  onNavigate: (route: string) => void;
+  activeFixture: AgentRunFixture | null;
+  onFixtureChange: (fixture: AgentRunFixture | null) => void;
+  isMobile: boolean;
+}) {
+  const t = useT();
+  const [draft, setDraft] = useState("");
+  const [messages, setMessages] = useState<CopilotMessage[]>([]);
+  const [stopped, setStopped] = useState(false);
+  const [showFullTimeline, setShowFullTimeline] = useState(!isMobile);
+  const edgeRef = useRef<HTMLButtonElement | null>(null);
+  const restoreFocusRef = useRef(false);
+  const closeRef = useRef<HTMLButtonElement | null>(null);
+  const inputRef = useRef<HTMLTextAreaElement | null>(null);
+
+  const latestRuntime = useMemo(() => {
+    const latest = [...messages].reverse().find((message) => message.runtime)?.runtime;
+    return latest ?? DIRECT_TRUTH;
+  }, [messages]);
+
+  useEffect(() => {
+    if (!open) return undefined;
+    const timer = window.setTimeout(() => {
+      (isMobile ? inputRef.current ?? closeRef.current : closeRef.current)?.focus();
+    }, 0);
+    return () => window.clearTimeout(timer);
+  }, [open, isMobile]);
+
+  useEffect(() => {
+    if (!open) return undefined;
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key === "Escape") {
+        restoreFocusRef.current = true;
+        onOpenChange(false);
+      }
+    };
+    window.addEventListener("keydown", onKeyDown);
+    return () => window.removeEventListener("keydown", onKeyDown);
+  }, [open, onOpenChange]);
+
+  useEffect(() => {
+    if (!open && restoreFocusRef.current) {
+      restoreFocusRef.current = false;
+      edgeRef.current?.focus();
+    }
+  }, [open]);
+
+  const append = (message: CopilotMessage) => setMessages((current) => [...current, message]);
+
+  const sendWhatIf = () => {
+    append({ id: nextMessageId(), role: "user", text: t("copilot.quickWhatIf") });
+    append({
+      id: nextMessageId(),
+      role: "assistant",
+      text: t("copilot.whatIfResult"),
+      intent: t("copilot.intent.whatIf"),
+      runtime: DIRECT_TRUTH,
+      whatIf: {
+        simulation_only: true,
+        status: t("copilot.whatIfStatus"),
+        changed_activity: "Five Great Avenues morning walk → 09:30 start",
+        unchanged_commitments: 1,
+      },
+    });
+    onFixtureChange(null);
+    setStopped(false);
+  };
+
+  const sendHermes = () => {
+    append({ id: nextMessageId(), role: "user", text: t("copilot.quickHermes") });
+    append({
+      id: nextMessageId(),
+      role: "assistant",
+      text: t("copilot.hermesResult"),
+      intent: t("copilot.intent.replan"),
+      runtime: HERMES_TRUTH,
+      fixture: HERMES_RECORDED_RUN,
+    });
+    onFixtureChange(HERMES_RECORDED_RUN);
+    setStopped(false);
+  };
+
+  const sendFallback = () => {
+    append({ id: nextMessageId(), role: "user", text: "DeepSeek is unavailable. What still works?" });
+    append({
+      id: nextMessageId(),
+      role: "assistant",
+      text: "Fallback runtime is active. CityNexus deterministic facts and the saved plan remain available; no live Hermes run was started.",
+      intent: "FALLBACK_PLAN",
+      runtime: FALLBACK_TRUTH,
+    });
+    onFixtureChange(null);
+    setStopped(false);
+  };
+
+  const sendUnavailable = () => {
+    append({ id: nextMessageId(), role: "user", text: "Try a native Hermes run." });
+    append({
+      id: nextMessageId(),
+      role: "assistant",
+      text: "Hermes is unavailable in this reference snapshot. CityNexus did not invent a run. Next useful action: use DIRECT planning or review the saved plan.",
+      intent: "HERMES_UNAVAILABLE",
+      runtime: UNAVAILABLE_TRUTH,
+    });
+    onFixtureChange(null);
+    setStopped(false);
+  };
+
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    const value = draft.trim();
+    if (!value) return;
+    setDraft("");
+    const isHermes = /replan|替代|rain|雨|alternative|change/i.test(value);
+    append({ id: nextMessageId(), role: "user", text: value });
+    if (isHermes) {
+      append({
+        id: nextMessageId(),
+        role: "assistant",
+        text: t("copilot.hermesResult"),
+        intent: t("copilot.intent.replan"),
+        runtime: HERMES_TRUTH,
+        fixture: HERMES_RECORDED_RUN,
+      });
+      onFixtureChange(HERMES_RECORDED_RUN);
+    } else {
+      append({
+        id: nextMessageId(),
+        role: "assistant",
+        text: t("copilot.whatIfResult"),
+        intent: t("copilot.intent.whatIf"),
+        runtime: DIRECT_TRUTH,
+        whatIf: {
+          simulation_only: true,
+          status: t("copilot.whatIfStatus"),
+          changed_activity: "Five Great Avenues morning walk → 09:30 start",
+          unchanged_commitments: 1,
+        },
+      });
+      onFixtureChange(null);
+    }
+    setStopped(false);
+  };
+
+  const miniPlaceholder = activeFixture ? t("copilot.miniActive") : t("copilot.miniIdle");
+  const approvalNeeded = Boolean(activeFixture?.events.some((item) => item.event_type === "approval.required"));
+
+  return (
+    <aside
+      className={`copilot${open ? " is-open" : " is-collapsed"}`}
+      data-testid={testIds.copilotDock}
+      aria-label={t("copilot.title")}
+    >
+      {!open && (
+        <>
+          <button
+            ref={edgeRef}
+            type="button"
+            className="copilot-edge"
+            onClick={() => onOpenChange(true)}
+            aria-label={t("copilot.open")}
+          >
+            <span aria-hidden="true">✦</span>
+            <span>{t("copilot.title")}</span>
+            <i className={`copilot-dot ${activeFixture ? "active" : latestRuntime.status === "ready" ? "live" : "warn"}`} />
+          </button>
+          <form
+            className="copilot-mini"
+            data-testid={testIds.copilotMiniComposer}
+            data-mini-state={activeFixture ? "active" : "idle"}
+            onSubmit={(event: FormEvent) => {
+              submit(event);
+              onOpenChange(true);
+            }}
+          >
+            <input
+              value={draft}
+              onChange={(event: ChangeEvent<HTMLInputElement>) => setDraft(event.target.value)}
+              placeholder={miniPlaceholder}
+              aria-label={miniPlaceholder}
+            />
+            <button type="submit" className="btn btn--primary" aria-label={t("copilot.send")}>
+              {t("copilot.send")}
+            </button>
+          </form>
+        </>
+      )}
+      {open && (
+        <div className="copilot-panel" role="dialog" aria-label={t("copilot.title")}>
+          <header className="copilot-head">
+            <div>
+              <span className="kicker">{t("copilot.kicker")}</span>
+              <b>{t("copilot.title")}</b>
+              <small>{t("copilot.subtitle")}</small>
+            </div>
+            <button
+              ref={closeRef}
+              type="button"
+              className="icon-btn"
+              onClick={() => {
+                restoreFocusRef.current = true;
+                onOpenChange(false);
+              }}
+              aria-label={t("copilot.close")}
+            >
+              ×
+            </button>
+          </header>
+          <RuntimeTruthBadge truth={latestRuntime} compact />
+          <RuntimeStatusBanner
+            status={latestRuntime.status}
+            onAction={() => onNavigate("journey")}
+          />
+          <div className="copilot-history" aria-live="polite">
+            {messages.length === 0 && <p className="muted">{t("copilot.empty")}</p>}
+            {messages.map((message) => (
+              <article
+                key={message.id}
+                className={`bubble ${message.role}`}
+                data-testid={testIds.copilotMessage}
+                data-role={message.role}
+              >
+                <small>{message.role === "user" ? "You" : "CityNexus"}</small>
+                <p>{message.text}</p>
+                <div className="bubble__chips">
+                  {message.intent && <span className="chip" data-testid="semantic-interpretation">{message.intent}</span>}
+                  {message.whatIf && <span className="chip">{message.whatIf.status}</span>}
+                  {message.runtime && (
+                    <span className="chip" data-testid={testIds.runtimeExecution}>
+                      {message.runtime.execution}
+                    </span>
+                  )}
+                </div>
+                {message.whatIf && (
+                  <>
+                    <button type="button" className="btn" onClick={() => onNavigate("recovery")}>
+                      {t("pulse.openRecovery")}
+                    </button>
+                    <dl className="whatif">
+                      <div>
+                        <dt>Changed</dt>
+                        <dd>{message.whatIf.changed_activity}</dd>
+                      </div>
+                      <div>
+                        <dt>Protected</dt>
+                        <dd>{message.whatIf.unchanged_commitments} C4 commitment unchanged</dd>
+                      </div>
+                    </dl>
+                  </>
+                )}
+              </article>
+            ))}
+          </div>
+          {activeFixture && (
+            <div className="mission-strip" data-testid="copilot-mission">
+              <small>{t("copilot.currentMission")}</small>
+              <b>{activeFixture.scenario}</b>
+              {approvalNeeded && <span className="chip warn">{t("copilot.approvalNeeded")}</span>}
+            </div>
+          )}
+          {activeFixture && (
+            <div className="fixture-switcher" role="group" aria-label={t("timeline.scenarios")}>
+              <span className="muted small">{t("timeline.scenarios")}</span>
+              {(["completed", "approved", "failed", "stopped"] as HermesFixtureKey[]).map((key) => (
+                <button
+                  key={key}
+                  type="button"
+                  className={`chip-btn${activeFixture.run_id === HERMES_FIXTURES[key].run_id ? " active" : ""}`}
+                  data-testid={`fixture-${key}`}
+                  onClick={() => onFixtureChange(HERMES_FIXTURES[key])}
+                >
+                  {t(`timeline.scenario.${key}`)}
+                </button>
+              ))}
+            </div>
+          )}
+          {activeFixture && (
+            <AgentRunTimeline
+              fixture={activeFixture}
+              compact={isMobile && !showFullTimeline}
+              onStop={() => {
+                setStopped(true);
+                onFixtureChange(null);
+              }}
+            />
+          )}
+          {stopped && (
+            <p className="fixture-banner stopped" role="status">
+              {t("timeline.stoppedLocally")}
+            </p>
+          )}
+          {activeFixture && isMobile && (
+            <button
+              type="button"
+              className="btn"
+              data-testid="copilot-toggle-timeline"
+              onClick={() => setShowFullTimeline((value) => !value)}
+            >
+              {showFullTimeline ? t("timeline.collapse") : t("copilot.expandTimeline")}
+            </button>
+          )}
+          <div className="copilot-quick">
+            <button type="button" className="chip-btn" data-testid={testIds.copilotQuickWhatIf} onClick={sendWhatIf}>
+              {t("copilot.quickWhatIf")}
+            </button>
+            <button type="button" className="chip-btn" data-testid={testIds.copilotQuickHermes} onClick={sendHermes}>
+              {t("copilot.quickHermes")}
+            </button>
+            <button type="button" className="chip-btn" data-testid="copilot-quick-fallback" onClick={sendFallback}>
+              {t("runtime.fallback")}
+            </button>
+            <button type="button" className="chip-btn" data-testid="copilot-quick-unavailable" onClick={sendUnavailable}>
+              {t("runtime.unavailable")}
+            </button>
+          </div>
+          <form className="copilot-form" onSubmit={submit}>
+            <textarea
+              ref={inputRef}
+              value={draft}
+              onChange={(event: ChangeEvent<HTMLTextAreaElement>) => setDraft(event.target.value)}
+              placeholder={t("copilot.placeholder")}
+              aria-label={t("copilot.placeholder")}
+              rows={2}
+              data-testid={testIds.copilotInput}
+            />
+            <button type="submit" className="btn btn--primary" data-testid={testIds.copilotSend}>
+              {t("copilot.send")}
+            </button>
+          </form>
+        </div>
+      )}
+    </aside>
+  );
+}
