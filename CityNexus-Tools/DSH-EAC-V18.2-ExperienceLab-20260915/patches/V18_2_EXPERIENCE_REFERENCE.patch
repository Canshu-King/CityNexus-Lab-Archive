+import { useT } from "../i18n";
+import { testIds } from "../testids";
+import type { PulseState } from "../types";
+import { RuntimeTruthBadge } from "./RuntimeTruthBadge";
+
+export function JourneyPulse({
+  pulse,
+  nowTitle,
+  nextTitle,
+  riskLevelLabel,
+  actionLabel,
+  nowNote,
+  nextNote,
+  riskTitle,
+  riskDetail,
+  actionReason,
+  onPrimaryAction,
+}: {
+  pulse: PulseState;
+  nowTitle: string;
+  nextTitle: string;
+  riskLevelLabel: string;
+  actionLabel: string;
+  nowNote: string;
+  nextNote: string;
+  riskTitle: string;
+  riskDetail: string;
+  actionReason: string;
+  onPrimaryAction: () => void;
+}) {
+  const t = useT();
+  return (
+    <section className="pulse" data-testid={testIds.journeyPulse}>
+      <header className="pulse__head">
+        <div>
+          <span className="kicker">{t("pulse.kicker")}</span>
+          <h2>{t("pulse.title")}</h2>
+        </div>
+        <RuntimeTruthBadge truth={{ semantic: "DeepSeek", execution: "DIRECT", truth: "CityNexus", source: "RECORDED_FIXTURE", status: "ready" }} compact />
+      </header>
+      <div className="pulse__grid">
+        <article className="pulse-card now" data-testid={testIds.pulseNow}>
+          <span className="pulse-card__label">{t("pulse.now")}</span>
+          <strong>{nowTitle}</strong>
+          <span className="pulse-card__time">
+            {pulse.now.time} · {pulse.now.eta}
+          </span>
+          <p>{nowNote}</p>
+        </article>
+        <article className="pulse-card next" data-testid={testIds.pulseNext}>
+          <span className="pulse-card__label">{t("pulse.next")}</span>
+          <strong>{nextTitle}</strong>
+          <span className="pulse-card__time">{pulse.next.time}</span>
+          <p>
+            {t("pulse.buffer", { n: pulse.next.buffer_min })} · {nextNote}
+          </p>
+        </article>
+        <article className={`pulse-card risk ${pulse.risk.level}`} data-testid={testIds.pulseRisk}>
+          <span className="pulse-card__label">{t("pulse.risk")}</span>
+          <strong>
+            {riskLevelLabel} · {riskTitle}
+          </strong>
+          <span className="pulse-card__source">{pulse.risk.source}</span>
+          <p>{riskDetail}</p>
+        </article>
+        <article className="pulse-card action" data-testid={testIds.pulseAction}>
+          <span className="pulse-card__label">{t("pulse.action")}</span>
+          <strong>{actionLabel}</strong>
+          <p>{actionReason}</p>
+          <button type="button" className="btn btn--primary" onClick={onPrimaryAction}>
+            {t("pulse.openRecovery")}
+          </button>
+        </article>
+      </div>
+      <details className="technical" data-testid={testIds.technicalEvidence}>
+        <summary>{t("pulse.technical")}</summary>
+        <div className="technical__body">
+          <p>{t("pulse.technicalHint")}</p>
+          <dl>
+            <div>
+              <dt>{t("pulse.dataSource")}</dt>
+              <dd>RECORDED_FIXTURE</dd>
+            </div>
+            <div>
+              <dt>{t("pulse.planVersion")}</dt>
+              <dd>V18.1-reference-r1</dd>
+            </div>
+            <div>
+              <dt>{t("pulse.generatedAt")}</dt>
+              <dd>2026-09-15T08:12:00+08:00</dd>
+            </div>
+            <div>
+              <dt>{t("runtime.execution")}</dt>
+              <dd>DIRECT</dd>
+            </div>
+          </dl>
+        </div>
+      </details>
+    </section>
+  );
+}
diff --git a/frontend/src/features/experience-lab/components/MapBottomSheet.tsx b/frontend/src/features/experience-lab/components/MapBottomSheet.tsx
new file mode 100644
--- /dev/null	2026-09-15 01:54:21.000000000 +0800
+++ b/frontend/src/features/experience-lab/components/MapBottomSheet.tsx
@@ -0,0 +1,86 @@
+import { useRef, useState, type CSSProperties, type KeyboardEvent as ReactKeyboardEvent, type PointerEvent as ReactPointerEvent, type ReactNode } from "react";
+import { useT } from "../i18n";
+import { testIds } from "../testids";
+
+export type SheetState = "24" | "55" | "90";
+
+export function MapBottomSheet({
+  children,
+  onStateChange,
+}: {
+  children: (state: SheetState) => ReactNode;
+  onStateChange?: (state: SheetState) => void;
+}) {
+  const t = useT();
+  const [state, setState] = useState<SheetState>("55");
+  const dragStart = useRef<{ y: number; state: SheetState } | null>(null);
+
+  const update = (next: SheetState) => {
+    setState(next);
+    onStateChange?.(next);
+  };
+
+  const onPointerDown = (event: ReactPointerEvent) => {
+    dragStart.current = { y: event.clientY, state };
+    (event.target as HTMLElement).setPointerCapture?.(event.pointerId);
+  };
+
+  const onPointerUp = (event: ReactPointerEvent) => {
+    if (!dragStart.current) return;
+    const delta = dragStart.current.y - event.clientY;
+    if (Math.abs(delta) > 40) {
+      const order: SheetState[] = ["24", "55", "90"];
+      const index = order.indexOf(dragStart.current.state);
+      update(order[Math.max(0, Math.min(order.length - 1, index + (delta > 0 ? 1 : -1)))]);
+    }
+    dragStart.current = null;
+  };
+
+  const heights: Record<SheetState, string> = { "24": "24%", "55": "55%", "90": "90%" };
+
+  return (
+    <div
+      className="sheet"
+      data-testid={testIds.mapSheet}
+      data-sheet-state={state}
+      style={{ "--sheet-height": heights[state] } as CSSProperties}
+    >
+      <div
+        className="sheet__handle"
+        data-testid={testIds.sheetHandle}
+        role="slider"
+        aria-label="Map sheet height"
+        aria-valuemin={24}
+        aria-valuemax={90}
+        aria-valuenow={Number(state)}
+        tabIndex={0}
+        onPointerDown={onPointerDown}
+        onPointerUp={onPointerUp}
+        onKeyDown={(event: ReactKeyboardEvent<HTMLDivElement>) => {
+          const order: SheetState[] = ["24", "55", "90"];
+          const index = order.indexOf(state);
+          if (event.key === "ArrowUp") update(order[Math.min(order.length - 1, index + 1)]);
+          if (event.key === "ArrowDown") update(order[Math.max(0, index - 1)]);
+        }}
+      />
+      <div className="sheet__tabs" role="tablist" aria-label="Map sheet state">
+        {(["24", "55", "90"] as SheetState[]).map((value) => (
+          <button
+            key={value}
+            type="button"
+            role="tab"
+            aria-selected={state === value}
+            className={`sheet__tab${state === value ? " active" : ""}`}
+            data-testid={value === "24" ? testIds.sheet24 : value === "55" ? testIds.sheet55 : testIds.sheet90}
+            onClick={() => update(value)}
+          >
+            {t(value === "24" ? "map.sheet24" : value === "55" ? "map.sheet55" : "map.sheet90")}
+          </button>
+        ))}
+      </div>
+      <div className="sheet__content" data-sheet-content={state}>
+        {children(state)}
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/features/experience-lab/components/MapCanvas.tsx b/frontend/src/features/experience-lab/components/MapCanvas.tsx
