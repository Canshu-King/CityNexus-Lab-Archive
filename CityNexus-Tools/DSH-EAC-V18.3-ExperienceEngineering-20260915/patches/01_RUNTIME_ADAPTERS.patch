@@ -0,0 +1,91 @@
+/**
+ * Adapter layer barrel.
+ *
+ * This module deliberately contains no JSX, so it can be imported by both the
+ * browser bundle and the `node --experimental-strip-types` contract test.
+ * The React bindings live in `ExperienceAdapterContext.tsx`, which imports
+ * `createExperienceAdapter` from here.
+ */
+
+import { LiveCityNexusAdapter } from "./liveCityNexusAdapter";
+import { OfflineSnapshotAdapter } from "./offlineSnapshotAdapter";
+import { RecordedFixtureAdapter } from "./recordedFixtureAdapter";
+import type { AdapterMode, ExperienceAdapter } from "./contract";
+
+export type {
+  AdapterMode,
+  ApprovalDecisionInput,
+  ApprovalDecisionResult,
+  CopilotMissionStart,
+  ExperienceAdapter,
+  MapState,
+  NormalizedAgentEvent,
+  NormalizedEventType,
+  NormalizedProposal,
+  NormalizedRun,
+  NormalizedRunStatus,
+  RecordedScenarioSummary,
+  RunEventHandlers,
+  RunSubscription,
+  RuntimeStatusInfo,
+  StopResult,
+} from "./contract";
+
+export { LiveCityNexusAdapter, AdapterHttpError } from "./liveCityNexusAdapter";
+export type {
+  EventSourceFactory,
+  EventSourceLike,
+  LiveCityNexusOptions,
+  LiveDiagnostic,
+  LiveMessageEvent,
+} from "./liveCityNexusAdapter";
+export { OfflineSnapshotAdapter } from "./offlineSnapshotAdapter";
+export { RecordedFixtureAdapter, buildFixtureMapState, normalizedFixtureEvents } from "./recordedFixtureAdapter";
+export type { RecordedRunSubscription, RecordedScenarioKey } from "./recordedFixtureAdapter";
+export type { OfflineRunSubscription } from "./offlineSnapshotAdapter";
+export {
+  AgentEventStore,
+  EventStore,
+  buildNormalizedRun,
+  compareNormalizedEvents,
+  deriveRunStatus,
+} from "./eventStore";
+export type { AppendOptions, BuildRunInput, EventStoreOptions } from "./eventStore";
+export {
+  NORMALIZED_EVENT_TYPES,
+  eventNameFromRaw,
+  isIgnoredRawEvent,
+  normalizeAgentEvent,
+  normalizeEventBatch,
+  normalizeEventType,
+  normalizeRawEvent,
+  normalizeRawEvents,
+  safeSummary,
+  toolNameFromRaw,
+} from "./normalize";
+export type { NormalizeOptions, RawAgentEvent } from "./normalize";
+
+function adapterModeFromLocation(): AdapterMode | null {
+  if (typeof window === "undefined") return null;
+  const value = new URLSearchParams(window.location.search).get("adapter");
+  return value === "live" || value === "offline" || value === "recorded" ? value : null;
+}
+
+function isBrowserOffline(): boolean {
+  return typeof navigator !== "undefined" && navigator.onLine === false;
+}
+
+/**
+ * Choose an adapter implementation.
+ *
+ * - `?adapter=live` -> LiveCityNexusAdapter
+ * - `?adapter=offline` or `navigator.onLine === false` -> OfflineSnapshotAdapter
+ * - default -> RecordedFixtureAdapter
+ */
+export function createExperienceAdapter(mode?: AdapterMode): ExperienceAdapter {
+  const requested = mode ?? adapterModeFromLocation();
+  if (requested === "live") return new LiveCityNexusAdapter();
+  if (requested === "offline") return new OfflineSnapshotAdapter();
+  if (isBrowserOffline()) return new OfflineSnapshotAdapter();
+  return new RecordedFixtureAdapter();
+}
diff --git a/frontend/src/features/experience-lab/adapters/liveCityNexusAdapter.ts b/frontend/src/features/experience-lab/adapters/liveCityNexusAdapter.ts
new file mode 100644
index 0000000..f0f8726
--- /dev/null
+++ b/frontend/src/features/experience-lab/adapters/liveCityNexusAdapter.ts
@@ -0,0 +1,772 @@
+/**
+ * LiveCityNexusAdapter — the real CityNexus REST/SSE contract at `/api/v1`.
+ *
+ * Source honesty:
+ * - `source: "LIVE"` is reported only after a real HTTP response or SSE frame
+ *   has been received.
+ * - When fetch/EventSource fails the adapter never invents runtime progress.
+ *   It surfaces a retryable `onError` and falls back to OfflineSnapshotAdapter
+ *   semantics (`source: "OFFLINE"`).
+ * - Approval success is shown only after server truth returns; network losses
+ *   never become authoritative success.
+ *
+ * Reconnect policy:
+ * - SSE is re-opened with `?since_sequence=` and a `last_event_id` query value
+ *   (browsers also send `Last-Event-ID`); duplicate frames are de-duplicated by
+ *   EventStore and a payload signature set.
+ * - Backoff is bounded to 3 attempts. Timers are used only for network
+ *   reconnect, never to generate events.
+ */
+
+import type {
+  DataSource,
+  PulseState,
+  RecoveryProposal,
+  RuntimeIdentity,
+  RuntimeStatus,
+} from "../types";
+import type {
+  AdapterMode,
+  ApprovalDecisionInput,
+  ApprovalDecisionResult,
+  CopilotMissionStart,
+  ExperienceAdapter,
+  MapState,
+  NormalizedAgentEvent,
+  NormalizedProposal,
+  NormalizedRun,
+  NormalizedRunStatus,
+  RunEventHandlers,
+  RunSubscription,
+  RuntimeStatusInfo,
+  StopResult,
+} from "./contract";
+import { EventStore, buildNormalizedRun } from "./eventStore";
+import { NORMALIZED_EVENT_TYPES } from "./normalize";
+import type { RawAgentEvent } from "./normalize";
+import { OfflineSnapshotAdapter } from "./offlineSnapshotAdapter";
+
+type RawEvent = RawAgentEvent;
+
+export const LIVE_API_BASE = "/api/v1";
+const DEFAULT_JOURNEY_ID = "journey-reference-tianjin-20260915";
+const MAX_SSE_ATTEMPTS = 3;
+const DEFAULT_REQUEST_TIMEOUT_MS = 15_000;
+
+export interface LiveMessageEvent {
+  data?: string;
+  lastEventId?: string;
+  type?: string;
+}
+
+export interface EventSourceLike {
+  addEventListener(type: string, listener: (event: LiveMessageEvent) => void): void;
+  removeEventListener?(type: string, listener: (event: LiveMessageEvent) => void): void;
+  close(): void;
+  onopen?: ((event: unknown) => void) | null;
+  onerror?: ((event: unknown) => void) | null;
+  readyState?: number;
+}
+
+export type EventSourceFactory = (url: string) => EventSourceLike;
+
+export interface LiveDiagnostic {
+  message: string;
+  source: DataSource;
+  retryable: boolean;
+  detail?: string;
+}
+
+export interface LiveCityNexusOptions {
+  baseUrl?: string;
+  journeyId?: string;
+  fetchImpl?: typeof fetch;
+  eventSourceFactory?: EventSourceFactory;
+  requestTimeoutMs?: number;
+  onDiagnostic?: (diagnostic: LiveDiagnostic) => void;
+}
+
+export class AdapterHttpError extends Error {
+  readonly status: number;
+  readonly body: unknown;
+
+  constructor(status: number, body: unknown, message: string) {
+    super(message);
+    this.name = "AdapterHttpError";
+    this.status = status;
+    this.body = body;
+  }
+}
+
+function isAdapterHttpError(error: unknown): error is AdapterHttpError {
+  return error instanceof AdapterHttpError;
+}
+
+function defaultEventSourceFactory(url: string): EventSourceLike {
+  const globalObject = globalThis as { EventSource?: new (url: string) => EventSourceLike };
+  if (typeof globalObject.EventSource !== "function") {
+    throw new AdapterHttpError(0, null, "EventSource is not available in this environment");
+  }
+  return new globalObject.EventSource(url);
+}
+
+function journeyIdFromLocation(): string | null {
+  if (typeof window === "undefined") return null;
+  const value = new URLSearchParams(window.location.search).get("journey");
+  return value && value.length > 0 ? value : null;
+}
+
+function asText(value: unknown): string | undefined {
+  if (value === null || value === undefined) return undefined;
+  const text = String(value);
+  return text.length > 0 ? text : undefined;
+}
+
+function mapRuntimeIdentity(value: unknown): RuntimeIdentity {
+  const text = String(value ?? "").toUpperCase();
+  if (
+    text === "DIRECT" ||
+    text === "HERMES_NATIVE_MCP" ||
+    text === "HERMES_COMPAT_ENDPOINT" ||
+    text === "NATIVE_DEEPSEEK_TOOL_LOOP" ||
+    text === "FALLBACK" ||
+    text === "UNAVAILABLE"
+  ) {
+    return text;
+  }
+  return "UNAVAILABLE";
+}
+
+function mapRunStatus(value: unknown): NormalizedRunStatus | null {
+  const status = String(value ?? "").toLowerCase();
+  if (["failed", "error", "failure"].includes(status)) return "failed";
+  if (["stopped", "cancelled", "canceled"].includes(status)) return "stopped";
+  if (["completed", "succeeded", "success", "done"].includes(status)) return "success";
+  if (["approval_required", "awaiting_approval", "pending_approval"].includes(status)) {
+    return "approval_required";
+  }
+  if (["running", "started", "in_progress", "active", "processing"].includes(status)) return "running";
+  return null;
+}
+
+function runtimeStatusFromPayload(payload: RawEvent): RuntimeStatusInfo {
+  const identity = mapRuntimeIdentity(payload.runtime_identity);
+  let status: RuntimeStatus = "ready";
+  if (identity === "UNAVAILABLE") status = "hermes_unavailable";
+  else if (payload.deepseek_configured === false) status = "deepseek_unavailable";
+  else if (payload.native_binary_detected === false && payload.hermes_compat_configured === false) {
+    status = "hermes_unavailable";
+  }
+  return {
+    identity,
+    status,
+    source: "LIVE",
+    last_updated: new Date().toISOString(),
+    detail: asText(payload.mcp_server) ? `MCP server: ${asText(payload.mcp_server)}` : undefined,
+  };
+}
+
+function intentFromPayload(payload: RawEvent): string {
+  const intent = payload.intent;
+  if (intent && typeof intent === "object") {
+    const record = intent as RawEvent;
+    const envelope = record.semantic_envelope;
+    if (envelope && typeof envelope === "object") {
+      const envelopeIntent = (envelope as RawEvent).intent;
+      if (typeof envelopeIntent === "string" && envelopeIntent.length > 0) return envelopeIntent;
+    }
+    if (typeof record.name === "string" && record.name.length > 0) return record.name;
+  }
+  return "MESSAGE";
+}
+
+export class LiveCityNexusAdapter implements ExperienceAdapter {
+  readonly mode: AdapterMode = "live";
+  readonly source: DataSource = "LIVE";
+
+  private readonly baseUrl: string;
+  private readonly defaultJourneyId: string;
+  private readonly fetchImpl: typeof fetch;
+  private readonly eventSourceFactory: EventSourceFactory;
+  private readonly requestTimeoutMs: number;
+  private readonly onDiagnostic?: (diagnostic: LiveDiagnostic) => void;
+  private readonly offline = new OfflineSnapshotAdapter();
+  private readonly runJourneyIds = new Map<string, string>();
+  private lastDiagnostic: LiveDiagnostic | null = null;
+
+  constructor(options: LiveCityNexusOptions = {}) {
+    this.baseUrl = options.baseUrl ?? LIVE_API_BASE;
+    this.defaultJourneyId = options.journeyId ?? journeyIdFromLocation() ?? DEFAULT_JOURNEY_ID;
+    this.fetchImpl = options.fetchImpl ?? ((input, init) => fetch(input, init));
+    this.eventSourceFactory = options.eventSourceFactory ?? defaultEventSourceFactory;
+    this.requestTimeoutMs = options.requestTimeoutMs ?? DEFAULT_REQUEST_TIMEOUT_MS;
+    this.onDiagnostic = options.onDiagnostic;
+  }
+
+  getLastUpdated(): string {
+    return new Date().toISOString();
+  }
+
+  getLastDiagnostic(): LiveDiagnostic | null {
+    return this.lastDiagnostic;
+  }
+
+  // ---------------------------------------------------------------- read-only
+  async getJourneyPulse(): Promise<PulseState> {
+    this.diagnose("live journey pulse projection is not exposed by the required endpoint set", "OFFLINE", true);
+    return this.offline.getJourneyPulse();
+  }
+
+  async getRuntimeStatus(): Promise<RuntimeStatusInfo> {
+    try {
+      const payload = await this.requestJson<RawEvent>("/agent/runtime-status");
+      return runtimeStatusFromPayload(payload);
+    } catch (error) {
+      this.diagnose("live runtime status unavailable", "OFFLINE", true, error);
+      return this.offline.getRuntimeStatus();
+    }
+  }
+
+  async getRecoveryDiff(proposalId?: string): Promise<RecoveryProposal | null> {
+    this.diagnose(
+      "live recovery projection requires the journey recovery endpoint; using cached snapshot",
+      "OFFLINE",
+      true,
+    );
+    return this.offline.getRecoveryDiff(proposalId);
+  }
+
+  async getMapState(): Promise<MapState> {
+    const journeyId = this.journeyIdFor();
+    try {
+      const payload = await this.requestJson<RawEvent>(`/journeys/${journeyId}/route-evidence`);
+      return this.mapRouteEvidence(payload, journeyId);
+    } catch (error) {
+      this.diagnose("live route evidence unavailable", "OFFLINE", true, error);
+      return this.offline.getMapState();
+    }
+  }
+
+  async getTodayTimeline() {
+    return this.offline.getTodayTimeline();
+  }
+
+  async getProposal(proposalId?: string): Promise<NormalizedProposal | null> {
+    this.diagnose("live proposal projection is not exposed by the required endpoint set", "OFFLINE", true);
+    return this.offline.getProposal(proposalId);
+  }
+
+  // ------------------------------------------------------------------- copilot
+  async startCopilotMission(input: { message: string; locale: "en" | "zh-CN" }): Promise<CopilotMissionStart> {
+    const journeyId = this.journeyIdFor();
+    try {
+      const payload = await this.requestJson<RawEvent>(`/journeys/${journeyId}/copilot/messages`, {
+        method: "POST",
+        body: JSON.stringify({ message: input.message, locale: input.locale === "zh-CN" ? "zh" : "en" }),
+      });
+      const agentRun = payload.agent_run;
+      const semanticIntent = intentFromPayload(payload);
+      const answer = asText(payload.message) ?? "CityNexus responded.";
+      if (agentRun && typeof agentRun === "object") {
+        const runPayload = agentRun as RawEvent;
+        const runId = asText(runPayload.run_id) ?? asText(runPayload.id);
+        if (runId) {
+          this.runJourneyIds.set(runId, journeyId);
+          const initial = Array.isArray(runPayload.initial_events) ? runPayload.initial_events : [];
+          const events = this.normalizeLiveEvents(initial, runId);
+          const run = this.buildLiveRun(runPayload, runId, journeyId, events);
+          return {
+            mission_id: asText(runPayload.mission_id) ?? asText(payload.mission_id) ?? runId,
+            run,
+            semantic_intent: semanticIntent,
+            answer,
+            source: "LIVE",
+          };
+        }
+      }
+      // The server answered honestly but did not start a run.
+      const idleRun = buildNormalizedRun({
+        runId: "no-run",
+        journeyId,
+        runtimeIdentity: "DIRECT",
+        providerKey: "citynexus",
+        modelKey: "none",
+        events: [],
+        source: "LIVE",
+        status: "idle",
+        lastUpdated: new Date().toISOString(),
+      });
+      return {
+        mission_id: asText(payload.mission_id) ?? "mission",
+        run: idleRun,
+        semantic_intent: semanticIntent,
+        answer,
+        source: "LIVE",
+      };
+    } catch (error) {
+      this.diagnose("live copilot mission failed", "OFFLINE", true, error);
+      const fallback = await this.offline.startCopilotMission(input);
+      return { ...fallback, answer: `Live CityNexus is unreachable. ${fallback.answer}` };
+    }
+  }
+
+  async getRun(runId: string): Promise<NormalizedRun | null> {
+    const journeyId = this.journeyIdFor(runId);
+    let sawNetworkFailure = false;
+    let sawNotFound = false;
+    const safeRequest = async (path: string): Promise<RawEvent | null> => {
+      try {
+        return await this.requestJson<RawEvent>(path);
+      } catch (error) {
+        if (isAdapterHttpError(error) && error.status === 404) sawNotFound = true;
+        else sawNetworkFailure = true;
+        return null;
+      }
+    };
+    const timeline = await safeRequest(
+      `/journeys/${journeyId}/agent/hermes/runs/${encodeURIComponent(runId)}/timeline`,
+    );
+    const runPayload = await safeRequest(
+      `/journeys/${journeyId}/agent/hermes/runs/${encodeURIComponent(runId)}`,
+    );
+    if (!timeline && !runPayload) {
+      if (sawNetworkFailure && !sawNotFound) {
+        this.diagnose("live run lookup failed", "OFFLINE", true);
+        return this.offline.getRun(runId);
+      }
+      return null;
+    }
+    const rawEvents = Array.isArray(timeline?.events)
+      ? timeline.events
+      : Array.isArray(runPayload?.initial_events)
+        ? runPayload.initial_events
+        : [];
+    const events = this.normalizeLiveEvents(rawEvents, runId);
+    const observability =
+      timeline?.observability && typeof timeline.observability === "object"
+        ? (timeline.observability as RawEvent)
+        : {};
+    const merged: RawEvent = {
+      ...observability,
+      ...runPayload,
+      run_id: runId,
+      journey_id: journeyId,
+      runtime_identity: runPayload?.runtime_identity ?? timeline?.runtime_identity ?? "HERMES_NATIVE_MCP",
+    };
+    return this.buildLiveRun(merged, runId, journeyId, events);
+  }
+
+  subscribeRunEvents(
+    runId: string,
+    handlers: RunEventHandlers,
+    options?: { since_sequence?: number },
+  ): RunSubscription {
+    const journeyId = this.journeyIdFor(runId);
+    const store = new EventStore({ source: "LIVE" });
+    const signatures = new Set<string>();
+    let closed = false;
+    let usingOffline = false;
+    let attempt = 0;
+    let lastEventId = "";
+    let eventSource: EventSourceLike | null = null;
+    let retryTimer: ReturnType<typeof setTimeout> | null = null;
+    let offlineSubscription: RunSubscription | null = null;
+
+    const sinceStart = options?.since_sequence ?? 0;
+    if (sinceStart > store.getLastSequence()) {
+      // The cursor is a caller hint only; the server still owns sequence truth.
+      store.append([], { source: "LIVE", runId });
+    }
+
+    const currentRun = (): NormalizedRun =>
+      buildNormalizedRun({
+        runId,
+        journeyId,
+        runtimeIdentity: "HERMES_NATIVE_MCP",
+        providerKey: "hermes-native",
+        modelKey: "unknown",
+        events: store.snapshot(),
+        source: "LIVE",
+        lastUpdated: new Date().toISOString(),
+      });
+
+    const fallbackToOffline = (message: string): void => {
+      if (usingOffline || closed) return;
+      usingOffline = true;
+      handlers.onError?.({ message, retryable: true, source: "LIVE" });
+      offlineSubscription = this.offline.subscribeRunEvents(runId, handlers, options);
+    };
+
+    const handleMessage = (event: LiveMessageEvent): void => {
+      if (closed || usingOffline) return;
+      const data = typeof event.data === "string" ? event.data : "";
+      if (!data) return;
+      let raw: RawEvent;
+      try {
+        raw = JSON.parse(data) as RawEvent;
+      } catch {
+        handlers.onError?.({ message: "Malformed SSE frame ignored", retryable: true, source: "LIVE" });
+        return;
+      }
+      if (event.lastEventId) lastEventId = event.lastEventId;
+      const signature = JSON.stringify(raw);
+      if (signatures.has(signature)) return;
+      signatures.add(signature);
+      const inserted = store.append(raw, { source: "LIVE", runId });
+      if (inserted.length === 0) return;
+      for (const item of inserted) handlers.onEvent(item);
+      handlers.onStatusChange?.(currentRun());
+    };
+
+    const closeSource = (): void => {
+      if (!eventSource) return;
+      try {
+        eventSource.close();
+      } catch {
+        // Closing a failed EventSource is best-effort.
+      }
+      eventSource = null;
+    };
+
+    const handleSseError = (): void => {
+      closeSource();
+      if (closed || usingOffline) return;
+      if (attempt < MAX_SSE_ATTEMPTS) {
+        attempt += 1;
+        handlers.onReconnect?.({ attempt, since_sequence: store.getLastSequence() });
+        const delay = Math.min(4000, 500 * 2 ** (attempt - 1));
+        retryTimer = setTimeout(open, delay);
+        return;
+      }
+      fallbackToOffline("Live SSE unavailable after bounded retries; showing the offline snapshot.");
+    };
+
+    const open = (): void => {
+      if (closed || usingOffline) return;
+      const params = new URLSearchParams();
+      params.set("since_sequence", String(store.getLastSequence()));
+      if (lastEventId) params.set("last_event_id", lastEventId);
+      const url =
+        `${this.baseUrl}/journeys/${encodeURIComponent(journeyId)}/agent/hermes/runs/` +
+        `${encodeURIComponent(runId)}/events?${params.toString()}`;
+      let next: EventSourceLike;
+      try {
+        next = this.eventSourceFactory(url);
+      } catch (error) {
+        this.diagnose("EventSource could not be created", "OFFLINE", true, error);
+        fallbackToOffline("Live SSE could not be opened; showing the offline snapshot.");
+        return;
+      }
+      eventSource = next;
+      next.onopen = () => {
+        attempt = 0;
+      };
+      next.onerror = () => {
+        handleSseError();
+      };
+      const listener = (event: LiveMessageEvent): void => handleMessage(event);
+      const eventTypes = [...NORMALIZED_EVENT_TYPES, "message", "unknown"];
+      for (const type of eventTypes) next.addEventListener(type, listener);
+    };
+
+    open();
+
+    return {
+      unsubscribe: () => {
+        closed = true;
+        if (retryTimer !== null) {
+          clearTimeout(retryTimer);
+          retryTimer = null;
+        }
+        closeSource();
+        offlineSubscription?.unsubscribe();
+        offlineSubscription = null;
+      },
+      getLastSequence: () => store.getLastSequence(),
+      isLive: () => !closed && !usingOffline,
+    };
+  }
+
+  async stopRun(runId: string): Promise<StopResult> {
+    const journeyId = this.journeyIdFor(runId);
+    try {
+      const payload = await this.requestJson<RawEvent>(
+        `/journeys/${journeyId}/agent/hermes/runs/${encodeURIComponent(runId)}/stop`,
+        { method: "POST" },
+      );
+      return {
+        ok: true,
+        run_id: runId,
+        status: mapRunStatus(payload?.status) ?? "stopped",
+        reason: asText(payload?.failure_reason),
+        source: "LIVE",
+      };
+    } catch (error) {
+      if (isAdapterHttpError(error)) {
+        return {
+          ok: false,
+          run_id: runId,
+          status: "running",
+          reason: `http_${error.status}`,
+          source: "LIVE",
+        };
+      }
+      this.diagnose("live stop failed", "OFFLINE", true, error);
+      return { ok: false, run_id: runId, status: "running", reason: "network_loss", source: "OFFLINE" };
+    }
+  }
+
+  async submitApprovalDecision(input: ApprovalDecisionInput): Promise<ApprovalDecisionResult> {
+    const lastUpdated = new Date().toISOString();
+    if (!input.online) {
+      return {
+        state: "approval_required",
+        server_truth: false,
+        proposal_id: input.proposal_id,
+        approval_id: input.approval_id,
+        reason: "offline",
+        retryable: true,
+        message: "Offline: approval is disabled until authoritative truth returns.",
+        last_updated: lastUpdated,
+      };
+    }
+    if (!input.approval_id) {
+      return {
+        state: "approval_required",
+        server_truth: false,
+        proposal_id: input.proposal_id,
+        reason: "failed",
+        retryable: false,
+        message: "No server approval_id is available for this proposal.",
+        last_updated: lastUpdated,
+      };
+    }
+    const journeyId = this.journeyIdFor();
+    try {
+      const payload = await this.requestJson<RawEvent>(
+        `/journeys/${journeyId}/agent/approvals/${encodeURIComponent(input.approval_id)}/approve`,
+        { method: "POST", body: JSON.stringify({ approval_method: "USER_CONFIRMATION" }) },
+      );
+      const status = String(payload?.status ?? "PENDING").toUpperCase();
+      const base = {
+        proposal_id: input.proposal_id,
+        approval_id: input.approval_id,
+        server_truth: true,
+        last_updated: new Date().toISOString(),
+      };
+      if (status === "APPROVED" || status === "CONSUMED") {
+        return { ...base, state: "approved", retryable: false, message: `Server truth: ${status}` };
+      }
+      if (status === "REVOKED") {
+        return { ...base, state: "rejected", retryable: false, message: "Server truth: REVOKED" };
+      }
+      if (status === "EXPIRED") {
+        return {
+          ...base,
+          state: "approval_required",
+          reason: "expired",
+          retryable: false,
+          message: "Server truth: approval expired; refresh for a new proposal.",
+        };
+      }
+      return {
+        ...base,
+        state: "approval_required",
+        retryable: true,
+        message: `Server truth: ${status}`,
+      };
+    } catch (error) {
+      if (isAdapterHttpError(error)) {
+        const bodyText = JSON.stringify(error.body ?? "").toLowerCase();
+        if (error.status === 409) {
+          const reason =
+            bodyText.includes("expired")
+              ? "expired"
+              : bodyText.includes("consum")
+                ? "already_consumed"
+                : "superseded";
+          return {
+            state: reason === "already_consumed" ? "approved" : "approval_required",
+            server_truth: true,
+            proposal_id: input.proposal_id,
+            approval_id: input.approval_id,
+            reason,
+            retryable: false,
+            message: `Server truth 409: ${reason}. Refresh before retrying.`,
+            last_updated: new Date().toISOString(),
+          };
+        }
+        if (error.status === 404) {
+          return {
+            state: "approval_required",
+            server_truth: true,
+            proposal_id: input.proposal_id,
+            approval_id: input.approval_id,
+            reason: "failed",
+            retryable: false,
+            message: "Server truth 404: approval was not found.",
+            last_updated: new Date().toISOString(),
+          };
+        }
+        return {
+          state: "approval_required",
+          server_truth: true,
+          proposal_id: input.proposal_id,
+          approval_id: input.approval_id,
+          reason: "failed",
+          retryable: false,
+          message: `Server truth ${error.status}: approval did not apply.`,
+          last_updated: new Date().toISOString(),
+        };
+      }
+      this.diagnose("live approval failed", "OFFLINE", true, error);
+      return {
+        state: "approval_required",
+        server_truth: false,
+        proposal_id: input.proposal_id,
+        approval_id: input.approval_id,
+        reason: "network_loss",
+        retryable: true,
+        message: "Network loss during approval. No authoritative success is shown.",
+        last_updated: new Date().toISOString(),
+      };
+    }
+  }
+
+  // ------------------------------------------------------------------ internals
+  private journeyIdFor(_runId?: string): string {
+    if (_runId) {
+      const mapped = this.runJourneyIds.get(_runId);
+      if (mapped) return mapped;
+    }
+    return this.defaultJourneyId;
+  }
+
+  private normalizeLiveEvents(rawEvents: readonly unknown[], runId: string): NormalizedAgentEvent[] {
+    const store = new EventStore({ source: "LIVE" });
+    store.append(rawEvents, { source: "LIVE", runId });
+    return store.snapshot();
+  }
+
+  private buildLiveRun(
+    payload: RawEvent,
+    runId: string,
+    journeyId: string,
+    events: NormalizedAgentEvent[],
+  ): NormalizedRun {
+    const statusHint = mapRunStatus(payload.status) ?? undefined;
+    return buildNormalizedRun({
+      runId,
+      journeyId: asText(payload.journey_id) ?? journeyId,
+      runtimeIdentity: mapRuntimeIdentity(payload.runtime_identity ?? "HERMES_NATIVE_MCP"),
+      providerKey: asText(payload.provider_key),
+      modelKey: asText(payload.model_key),
+      events,
+      source: "LIVE",
+      status: statusHint,
+      startedAt: asText(payload.started_at),
+      completedAt: payload.completed_at === null ? null : asText(payload.completed_at),
+      lastUpdated: new Date().toISOString(),
+    });
+  }
+
+  private mapRouteEvidence(payload: RawEvent, journeyId: string): MapState {
+    const feature = (payload.new_route ?? payload.old_route) as RawEvent | undefined;
+    const geometry = feature?.geometry as RawEvent | undefined;
+    const coordinates = Array.isArray(geometry?.coordinates)
+      ? (geometry?.coordinates as Array<[number, number]>)
+      : [];
+    if (coordinates.length === 0) {
+      throw new AdapterHttpError(0, payload, "route evidence contained no geometry");
+    }
+    const markerCollection = payload.markers as RawEvent | undefined;
+    const markerFeatures = Array.isArray(markerCollection?.features)
+      ? (markerCollection?.features as RawEvent[])
+      : [];
+    const stops = markerFeatures
+      .map((marker, index) => {
+        const properties = (marker.properties ?? {}) as RawEvent;
+        const markerGeometry = (marker.geometry ?? {}) as RawEvent;
+        const coordinate = markerGeometry.coordinates as [number, number] | undefined;
+        if (!Array.isArray(coordinate) || coordinate.length < 2) return null;
+        return {
+          id: asText(properties.activity_id) ?? asText(properties.role) ?? `stop-${index}`,
+          name: asText(properties.title) ?? "Stop",
+          coordinate: [Number(coordinate[0]), Number(coordinate[1])] as [number, number],
+        };
+      })
+      .filter((stop): stop is { id: string; name: string; coordinate: [number, number] } => stop !== null);
+    const longitudes = coordinates.map((coordinate) => coordinate[0]);
+    const latitudes = coordinates.map((coordinate) => coordinate[1]);
+    const minLng = Math.min(...longitudes);
+    const maxLng = Math.max(...longitudes);
+    const minLat = Math.min(...latitudes);
+    const maxLat = Math.max(...latitudes);
+    return {
+      journey_id: journeyId,
+      route: {
+        type: "Feature",
+        properties: { provenance: asText((feature?.properties as Record<string, unknown> | undefined)?.["provider"]) ?? "route-evidence" },
+        geometry: { type: "LineString", coordinates },
+      },
+      stops,
+      bounds: [
+        [minLng, minLat],
+        [maxLng, maxLat],
+      ],
+      center: [(minLng + maxLng) / 2, (minLat + maxLat) / 2],
+      source: "LIVE",
+      last_updated: new Date().toISOString(),
+    };
+  }
+
+  private diagnose(
+    message: string,
+    source: DataSource,
+    retryable: boolean,
+    error?: unknown,
+  ): void {
+    const diagnostic: LiveDiagnostic = {
+      message,
+      source,
+      retryable,
+      detail: error instanceof Error ? error.message : error === undefined ? undefined : String(error),
+    };
+    this.lastDiagnostic = diagnostic;
+    this.onDiagnostic?.(diagnostic);
+  }
+
+  private async requestJson<T>(path: string, init?: RequestInit): Promise<T> {
+    const controller = typeof AbortController !== "undefined" ? new AbortController() : null;
+    const timer =
+      controller && this.requestTimeoutMs > 0
+        ? setTimeout(() => controller.abort(), this.requestTimeoutMs)
+        : null;
+    try {
+      const response = await this.fetchImpl(this.baseUrl + path, {
+        ...init,
+        headers: {
+          Accept: "application/json",
+          "Content-Type": "application/json",
+          ...(init?.headers ?? {}),
+        },
+        signal: controller?.signal,
+      });
+      const text = await response.text();
+      let body: unknown = null;
+      if (text) {
+        try {
+          body = JSON.parse(text);
+        } catch {
+          body = text;
+        }
+      }
+      if (!response.ok) {
+        throw new AdapterHttpError(response.status, body, `CityNexus ${response.status}: ${path}`);
+      }
+      return body as T;
+    } finally {
+      if (timer !== null) clearTimeout(timer);
+    }
+  }
+}
diff --git a/frontend/src/features/experience-lab/adapters/normalize.ts b/frontend/src/features/experience-lab/adapters/normalize.ts
new file mode 100644
index 0000000..82e35b5
--- /dev/null
+++ b/frontend/src/features/experience-lab/adapters/normalize.ts
@@ -0,0 +1,412 @@
+/**
+ * Runtime normalization boundary for CityNexus V18.3.
+ *
+ * Mirrors the read-only server contract in
+ * `backend/app/agent/runtime_events.py`: raw Hermes/REST/SSE payloads are
+ * mapped to the stable `NormalizedAgentEvent` contract.
+ *
+ * Guarantees:
+ * - normalization never throws;
+ * - known streaming noise is dropped by returning `null`;
+ * - unrecognized event names become `unknown` with `unknown: true` and the
+ *   original `raw_event_type` preserved;
+ * - `citynexus__tool_name` style tool names are reduced to the suffix;
+ * - optional fields always receive safe defaults.
+ *
+ * Source honesty: the caller decides the `source`. Recorded fixtures pass
+ * `RECORDED_FIXTURE`, real responses/events pass `LIVE`, cached snapshots pass
+ * `OFFLINE`.
+ */
+
+import type { DataSource } from "../types";
+import type { NormalizedAgentEvent, NormalizedEventType } from "./contract";
+
+export type RawAgentEvent = Record<string, unknown>;
+
+/** The public semantic event set. Anything else normalizes to `unknown`. */
+export const NORMALIZED_EVENT_TYPES: readonly NormalizedEventType[] = [
+  "semantic.interpreted",
+  "mission.planned",
+  "run.started",
+  "tool.started",
+  "tool.completed",
+  "tool.failed",
+  "gateway.checked",
+  "guardian.checked",
+  "proposal.created",
+  "approval.required",
+  "run.completed",
+  "run.failed",
+  "run.stopped",
+];
+
+/** Streaming noise that must never become a timeline step. */
+const IGNORED_EVENT_NAMES: ReadonlySet<string> = new Set([
+  "message.delta",
+  "reasoning.available",
+  "reasoning.delta",
+  "content.delta",
+  "content",
+  "reasoning",
+  "heartbeat",
+  "heartbeat.delta",
+  "ping",
+  "pong",
+  "keepalive",
+  "keep.alive",
+  "token.delta",
+  "stream.delta",
+  "progress.delta",
+]);
+
+const TOOL_LABELS: Record<string, string> = {
+  inspect_journey: "Inspect current Journey",
+  inspect_twin: "Inspect JourneyTwin",
+  list_replans: "Inspect proposals and protected commitments",
+  search_city_services: "Search candidate places and services",
+  request_replan: "Request deterministic replan",
+  accept_replan: "Accept replan (CityNexus approval required)",
+  replace_activity: "Replace activity (CityNexus approval required)",
+  reschedule_activity: "Reschedule activity (CityNexus approval required)",
+  create_booking: "Create booking (CityNexus approval required)",
+  cancel_refundable_booking: "Cancel refundable booking (CityNexus approval required)",
+  request_commitment_change: "Request commitment change (CityNexus approval required)",
+};
+
+const ALLOWED_STATUSES: ReadonlySet<string> = new Set([
+  "started",
+  "completed",
+  "failed",
+  "approval_required",
+  "stopped",
+]);
+
+export interface NormalizeOptions {
+  /** Run id stamped when the raw payload has none. */
+  runId?: string | null;
+  /** Data source stamped on every event. Defaults to `RECORDED_FIXTURE`. */
+  source?: DataSource;
+  /** Fallback timestamp when the raw payload has none. */
+  receivedAt?: string;
+  /** Fallback sequence number when the raw payload has none. */
+  sequenceNo?: number;
+}
+
+function asString(value: unknown): string | null {
+  if (value === null || value === undefined) return null;
+  const text = String(value);
+  return text.length > 0 ? text : null;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Extract and canonicalize the raw event name (`_` -> `.`, lowercase). */
+export function eventNameFromRaw(raw: RawAgentEvent): string {
+  const candidate = raw.event_type ?? raw.event ?? raw.type ?? raw.name ?? raw.event_name;
+  const text = asString(candidate);
+  if (!text) return "run.started";
+  const normalized = text.trim().toLowerCase().replaceAll("_", ".");
+  return normalized.length > 0 ? normalized : "run.started";
+}
+
+/** True when the raw event is known streaming noise. */
+export function isIgnoredRawEvent(input: unknown): boolean {
+  if (!isRecord(input)) return false;
+  return IGNORED_EVENT_NAMES.has(eventNameFromRaw(input));
+}
+
+/** Tool names may arrive namespaced as `citynexus__search_city_services`. */
+export function toolNameFromRaw(raw: RawAgentEvent): string | null {
+  const value = raw.tool_name ?? raw.tool ?? (typeof raw.name === "string" ? raw.name : undefined);
+  if (value === null || value === undefined) return null;
+  let name = String(value).trim();
+  if (!name) return null;
+  const separator = name.lastIndexOf("__");
+  if (separator >= 0) name = name.slice(separator + 2).trim();
+  return name.length > 0 ? name : null;
+}
+
+/** Bounded, non free-form result projection (mirrors `_safe_summary`). */
+export function safeSummary(value: unknown): Record<string, unknown> | string | null {
+  if (value === null || value === undefined) return null;
+  if (Array.isArray(value)) return { items: value.length };
+  if (isRecord(value)) {
+    const result: Record<string, unknown> = {};
+    for (const key of [
+      "decision",
+      "status",
+      "approval_status",
+      "proposal_id",
+      "mission_id",
+      "executed",
+      "error",
+      "tool",
+    ]) {
+      const item = value[key];
+      if (typeof item === "string" || typeof item === "number" || typeof item === "boolean") {
+        result[key] = item;
+      }
+    }
+    if (Object.keys(result).length === 0) {
+      result.keys = Object.keys(value).map((key) => String(key)).sort().slice(0, 20);
+    }
+    return result;
+  }
+  if (typeof value === "string") return { kind: "text", length: value.length };
+  if (typeof value === "number" || typeof value === "boolean") return { value };
+  return null;
+}
+
+/** Map an arbitrary event name to the semantic contract. */
+export function normalizeEventType(
+  name: string,
+  raw: RawAgentEvent,
+  tool: string | null,
+): NormalizedEventType {
+  if ((NORMALIZED_EVENT_TYPES as readonly string[]).includes(name)) {
+    return name as NormalizedEventType;
+  }
+  if (name === "run" || name === "start" || name === "started" || name === "run.start") {
+    return "run.started";
+  }
+  if (name === "completed" || name === "succeeded" || name === "success") {
+    return "run.completed";
+  }
+  if (name === "failed" || name === "error" || name === "failure") {
+    return "run.failed";
+  }
+  if (name === "stopped" || name === "cancelled" || name === "canceled" || name === "cancel") {
+    return "run.stopped";
+  }
+  if (name.includes("approval")) return "approval.required";
+  if (name.includes("gateway") || name.includes("policy")) return "gateway.checked";
+  if (name.includes("guardian")) return "guardian.checked";
+  if (name.includes("proposal") && name.includes("created")) return "proposal.created";
+  if (tool) {
+    if (name.includes("failed") || name.includes("error") || raw.error === true) return "tool.failed";
+    if (
+      name.includes("completed") ||
+      name.includes("finished") ||
+      name.includes("done") ||
+      name.includes("ended") ||
+      raw.status === "completed" ||
+      raw.status === "succeeded"
+    ) {
+      return "tool.completed";
+    }
+    if (
+      name.includes("start") ||
+      name.includes("call") ||
+      name.includes("begin") ||
+      name.startsWith("tool") ||
+      raw.status === "started"
+    ) {
+      return "tool.started";
+    }
+  }
+  return "unknown";
+}
+
+function sequenceNoFromRaw(value: unknown): number | null {
+  if (typeof value === "number" && Number.isFinite(value)) return Math.trunc(value);
+  if (typeof value === "string" && value.trim() !== "") {
+    const parsed = Number(value);
+    if (Number.isFinite(parsed)) return Math.trunc(parsed);
+  }
+  return null;
+}
+
+function timestampFromRaw(value: unknown, fallback: string): string {
+  if (typeof value === "number" && Number.isFinite(value)) {
+    const milliseconds = value > 1e12 ? value : value * 1000;
+    const date = new Date(milliseconds);
+    return Number.isNaN(date.getTime()) ? fallback : date.toISOString();
+  }
+  if (typeof value === "string" && value.trim() !== "") return value;
+  return fallback;
+}
+
+function durationMsFromRaw(raw: RawAgentEvent): number | null {
+  const direct = raw.duration_ms;
+  if (typeof direct === "number" && Number.isFinite(direct)) return Math.round(direct);
+  if (typeof direct === "string" && direct.trim() !== "" && Number.isFinite(Number(direct))) {
+    return Math.round(Number(direct));
+  }
+  const seconds = raw.duration;
+  if (typeof seconds === "number" && Number.isFinite(seconds)) return Math.round(seconds * 1000);
+  if (typeof seconds === "string" && seconds.trim() !== "" && Number.isFinite(Number(seconds))) {
+    return Math.round(Number(seconds) * 1000);
+  }
+  return null;
+}
+
+function safeFallback(source: DataSource, receivedAt: string): NormalizedAgentEvent {
+  return {
+    id: "unknown:runtime",
+    run_id: "",
+    sequence_no: 0,
+    event_type: "unknown",
+    raw_event_type: "unknown",
+    tool_name: null,
+    friendly_label: "Hermes runtime",
+    status: "started",
+    timestamp: receivedAt,
+    duration_ms: null,
+    result_summary: null,
+    policy_decision: null,
+    source,
+    received_at: receivedAt,
+    unknown: true,
+  };
+}
+
+/**
+ * Normalize one raw runtime event. Returns `null` for noise or non-objects.
+ * Never throws.
+ */
+export function normalizeRawEvent(
+  input: unknown,
+  options: NormalizeOptions = {},
+): NormalizedAgentEvent | null {
+  const receivedAt = options.receivedAt ?? new Date().toISOString();
+  const source = options.source ?? "RECORDED_FIXTURE";
+  if (!isRecord(input)) return null;
+  const raw = input;
+
+  try {
+    const rawName = eventNameFromRaw(raw);
+    if (IGNORED_EVENT_NAMES.has(rawName)) return null;
+
+    const tool = toolNameFromRaw(raw);
+    const eventType = normalizeEventType(rawName, raw, tool);
+    const sequenceNo =
+      sequenceNoFromRaw(raw.sequence_no) ??
+      sequenceNoFromRaw(raw.sequence) ??
+      sequenceNoFromRaw(raw.seq) ??
+      sequenceNoFromRaw(raw.sequenceNumber) ??
+      (typeof options.sequenceNo === "number" ? options.sequenceNo : 0);
+    const explicitId = asString(raw.id) ?? asString(raw.event_id) ?? asString(raw.eventId);
+    const runId = asString(options.runId) ?? asString(raw.run_id) ?? asString(raw.runId) ?? "";
+    const id = explicitId ?? `${runId}:${sequenceNo}:${eventType}:${tool ?? "none"}`;
+
+    const timestamp = timestampFromRaw(raw.timestamp ?? raw.created_at ?? raw.started_at, receivedAt);
+    const durationMs = durationMsFromRaw(raw);
+
+    const resultCandidate =
+      raw.result ?? raw.output ?? (raw.error !== undefined ? { error: raw.error } : undefined);
+    let resultSummary: Record<string, unknown> | string | null =
+      isRecord(raw.result_summary) || typeof raw.result_summary === "string"
+        ? (raw.result_summary as Record<string, unknown> | string)
+        : null;
+    if (resultSummary === null && resultCandidate !== undefined) resultSummary = safeSummary(resultCandidate);
+    if (resultSummary === null && typeof raw.summary === "string" && raw.summary.length > 0) {
+      resultSummary = raw.summary;
+    }
+
+    const decision =
+      raw.policy_decision ??
+      raw.decision ??
+      (isRecord(resultCandidate) ? resultCandidate.decision : undefined);
+
+    const friendlyLabel =
+      asString(raw.friendly_label) ??
+      (typeof raw.summary === "string" && raw.summary.length > 0 ? raw.summary : null) ??
+      (tool ? TOOL_LABELS[tool] ?? tool : null) ??
+      "Hermes runtime";
+
+    let status = (asString(raw.status) ?? "started").toLowerCase();
+    if (eventType.endsWith("completed")) status = "completed";
+    else if (eventType.endsWith("failed")) status = "failed";
+    else if (eventType === "approval.required") status = "approval_required";
+    else if (eventType.endsWith("stopped")) status = "stopped";
+    else if (!ALLOWED_STATUSES.has(status)) status = "started";
+
+    const normalized: NormalizedAgentEvent = {
+      id,
+      run_id: runId,
+      sequence_no: sequenceNo,
+      event_type: eventType,
+      raw_event_type: rawName,
+      tool_name: tool,
+      friendly_label: friendlyLabel,
+      status,
+      timestamp,
+      duration_ms: durationMs,
+      result_summary: resultSummary,
+      policy_decision: asString(decision),
+      source,
+      received_at: receivedAt,
+      unknown: eventType === "unknown",
+    };
+
+    const approvalId =
+      asString(raw.approval_id) ??
+      (isRecord(resultCandidate) ? asString(resultCandidate.approval_id) : null);
+    const proposalId =
+      asString(raw.proposal_id) ??
+      (isRecord(resultCandidate) ? asString(resultCandidate.proposal_id) : null);
+    const missionId =
+      asString(raw.mission_id) ??
+      (isRecord(resultCandidate) ? asString(resultCandidate.mission_id) : null);
+    const approvalStatus =
+      asString(raw.approval_status) ??
+      (isRecord(resultCandidate)
+        ? asString(resultCandidate.approval_status) ?? asString(resultCandidate.status)
+        : null);
+
+    if (approvalId) normalized.approval_id = approvalId;
+    if (proposalId) normalized.proposal_id = proposalId;
+    if (missionId) normalized.mission_id = missionId;
+    if (approvalStatus) normalized.approval_status = approvalStatus;
+
+    return normalized;
+  } catch {
+    return safeFallback(source, receivedAt);
+  }
+}
+
+/** Normalize a batch, dropping noise and non-objects. */
+export function normalizeRawEvents(
+  inputs: readonly unknown[],
+  options: NormalizeOptions = {},
+): NormalizedAgentEvent[] {
+  const output: NormalizedAgentEvent[] = [];
+  for (const input of inputs) {
+    const normalized = normalizeRawEvent(input, options);
+    if (normalized) output.push(normalized);
+  }
+  return output;
+}
+
+/**
+ * Compatibility wrapper: normalize a single raw event with an explicit
+ * arrival index used as the fallback sequence number.
+ */
+export function normalizeAgentEvent(
+  raw: RawAgentEvent,
+  options: {
+    runId?: string | null;
+    source: DataSource;
+    arrivalIndex?: number;
+    receivedAt?: string;
+  },
+): NormalizedAgentEvent | null {
+  return normalizeRawEvent(raw, {
+    runId: options.runId,
+    source: options.source,
+    receivedAt: options.receivedAt,
+    sequenceNo: options.arrivalIndex,
+  });
+}
+
+/** Compatibility wrapper: normalize a batch with arrival-index sequencing. */
+export function normalizeEventBatch(
+  raws: readonly RawAgentEvent[],
+  options: { runId?: string | null; source: DataSource; receivedAt?: string },
+): NormalizedAgentEvent[] {
+  return raws
+    .map((raw, index) => normalizeAgentEvent(raw, { ...options, arrivalIndex: index }))
+    .filter((event): event is NormalizedAgentEvent => event !== null);
+}
diff --git a/frontend/src/features/experience-lab/adapters/offlineSnapshotAdapter.ts b/frontend/src/features/experience-lab/adapters/offlineSnapshotAdapter.ts
new file mode 100644
index 0000000..2e72ff8
--- /dev/null
+++ b/frontend/src/features/experience-lab/adapters/offlineSnapshotAdapter.ts
@@ -0,0 +1,188 @@
+/**
+ * OfflineSnapshotAdapter — read-only cached view of the same reference
+ * fixtures. It always reports `source: "OFFLINE"`.
+ *
+ * This adapter never starts a run, never creates events and never claims
+ * server truth. `submitApprovalDecision` always fails safely with
+ * `reason: "offline"` and `retryable: true`, so destructive approval actions
+ * stay disabled in the UI until authoritative connectivity returns.
+ */
+
+import type {
+  AgentRunFixture,
+  DataSource,
+  PulseState,
+  RecoveryProposal,
+} from "../types";
+import { HERMES_FIXTURES } from "./fixtures/hermesFixtures";
+import { JOURNEY, PULSE, RECOVERY, TODAY_TIMELINE } from "./fixtures/journeyFixtures";
+import type {
+  AdapterMode,
+  ApprovalDecisionInput,
+  ApprovalDecisionResult,
+  CopilotMissionStart,
+  ExperienceAdapter,
+  MapState,
+  NormalizedAgentEvent,
+  NormalizedProposal,
+  NormalizedRun,
+  RunEventHandlers,
+  RunSubscription,
+  RuntimeStatusInfo,
+  StopResult,
+} from "./contract";
+import { buildNormalizedRun } from "./eventStore";
+import { buildFixtureMapState, normalizedFixtureEvents } from "./recordedFixtureAdapter";
+
+export interface OfflineRunSubscription extends RunSubscription {
+  stop: () => void;
+  whenComplete: () => Promise<void>;
+}
+
+function cachedRun(fixture: AgentRunFixture, source: DataSource): NormalizedRun {
+  const events = normalizedFixtureEvents(fixture, source);
+  return buildNormalizedRun({
+    runId: fixture.run_id,
+    journeyId: JOURNEY.id,
+    runtimeIdentity: fixture.runtime_identity,
+    providerKey: fixture.provider_key,
+    modelKey: fixture.model_key,
+    events,
+    source,
+    lastUpdated: fixture.recorded_at,
+  });
+}
+
+export class OfflineSnapshotAdapter implements ExperienceAdapter {
+  readonly mode: AdapterMode = "offline";
+  readonly source: DataSource = "OFFLINE";
+
+  private readonly lastUpdatedIso: string;
+
+  constructor(lastUpdated: string = HERMES_FIXTURES.completed.recorded_at) {
+    this.lastUpdatedIso = lastUpdated;
+  }
+
+  /** ISO timestamp describing when the cached snapshot was captured. */
+  getLastUpdated(): string {
+    return this.lastUpdatedIso;
+  }
+
+  async getJourneyPulse(): Promise<PulseState> {
+    return { ...PULSE, risk: { ...PULSE.risk, source: this.source } };
+  }
+
+  async getRuntimeStatus(): Promise<RuntimeStatusInfo> {
+    return {
+      identity: "UNAVAILABLE",
+      status: "offline_stale",
+      source: this.source,
+      last_updated: this.lastUpdatedIso,
+      detail: "Offline cached snapshot. Destructive actions are disabled until authoritative truth returns.",
+    };
+  }
+
+  async getRecoveryDiff(proposalId?: string): Promise<RecoveryProposal | null> {
+    return {
+      ...RECOVERY,
+      proposal_id: proposalId ?? RECOVERY.proposal_id,
+      source: this.source,
+    };
+  }
+
+  async getMapState(): Promise<MapState> {
+    return buildFixtureMapState(this.source, this.lastUpdatedIso);
+  }
+
+  async getTodayTimeline() {
+    return TODAY_TIMELINE.map((item) => ({ ...item, title: { ...item.title } }));
+  }
+
+  async startCopilotMission(input: { message: string; locale: "en" | "zh-CN" }): Promise<CopilotMissionStart> {
+    // Read-only: no new run is started; the cached run is returned for context.
+    const run = cachedRun(HERMES_FIXTURES.completed, this.source);
+    return {
+      mission_id: "mission-offline-cache",
+      run,
+      semantic_intent: "OFFLINE",
+      answer:
+        "Offline snapshot: CityNexus cannot start or advance a live run until connectivity returns. " +
+        `Requested: ${input.message}`,
+      source: this.source,
+    };
+  }
+
+  async getRun(runId: string): Promise<NormalizedRun | null> {
+    const fixture = Object.values(HERMES_FIXTURES).find((candidate) => candidate.run_id === runId);
+    return fixture ? cachedRun(fixture, this.source) : null;
+  }
+
+  subscribeRunEvents(
+    runId: string,
+    handlers: RunEventHandlers,
+    options?: { since_sequence?: number },
+  ): OfflineRunSubscription {
+    const fixture =
+      Object.values(HERMES_FIXTURES).find((candidate) => candidate.run_id === runId) ??
+      HERMES_FIXTURES.completed;
+    const since = options?.since_sequence ?? 0;
+    const stored: NormalizedAgentEvent[] = normalizedFixtureEvents(fixture, this.source);
+    const replay = stored.filter((event) => event.sequence_no > since);
+    let lastSequence = since;
+
+    // Cached events are emitted once, synchronously. No timers, no invention.
+    for (const event of replay) {
+      lastSequence = Math.max(lastSequence, event.sequence_no);
+      handlers.onEvent(event);
+    }
+    if (replay.length > 0) {
+      handlers.onStatusChange?.(cachedRun(fixture, this.source));
+    }
+
+    return {
+      unsubscribe: () => undefined,
+      stop: () => undefined,
+      getLastSequence: () => lastSequence,
+      isLive: () => false,
+      whenComplete: () => Promise.resolve(),
+    };
+  }
+
+  async stopRun(runId: string): Promise<StopResult> {
+    const fixture = Object.values(HERMES_FIXTURES).find((candidate) => candidate.run_id === runId);
+    const status = fixture ? cachedRun(fixture, this.source).status : "stopped";
+    return {
+      ok: false,
+      run_id: runId,
+      status,
+      reason: "offline",
+      source: this.source,
+    };
+  }
+
+  async getProposal(proposalId?: string): Promise<NormalizedProposal | null> {
+    const id = proposalId ?? RECOVERY.proposal_id;
+    return {
+      proposal_id: id,
+      journey_id: JOURNEY.id,
+      title: { ...RECOVERY.trigger },
+      state: "proposal_only",
+      source: this.source,
+      recovery: { ...RECOVERY, proposal_id: id, source: this.source },
+      last_updated: this.lastUpdatedIso,
+    };
+  }
+
+  async submitApprovalDecision(input: ApprovalDecisionInput): Promise<ApprovalDecisionResult> {
+    return {
+      state: "approval_required",
+      server_truth: false,
+      proposal_id: input.proposal_id,
+      approval_id: input.approval_id,
+      reason: "offline",
+      retryable: true,
+      message: "Offline: destructive approval is disabled. Reconnect to refresh authoritative truth.",
+      last_updated: this.lastUpdatedIso,
+    };
+  }
+}
diff --git a/frontend/src/features/experience-lab/adapters/recordedFixtureAdapter.ts b/frontend/src/features/experience-lab/adapters/recordedFixtureAdapter.ts
new file mode 100644
index 0000000..e995697
--- /dev/null
+++ b/frontend/src/features/experience-lab/adapters/recordedFixtureAdapter.ts
@@ -0,0 +1,459 @@
+/**
+ * RecordedFixtureAdapter — deterministic replay of the checked-in reference
+ * fixtures. It always reports `source: "RECORDED_FIXTURE"` and never claims
+ * server truth.
+ *
+ * Recorded scenario keys: `completed` (14 events, approval_required),
+ * `approved` (15 events, success), `failed` (6 events), `stopped` (5 events).
+ *
+ * Approval simulation (documented):
+ * - `selectRecordedScenario(key)` accepts either one of the four scenario keys
+ *   or an approval-outcome override: `approval:expired`,
+ *   `approval:superseded`, `approval:already_consumed`, `approval:offline`,
+ *   `approval:rejected`, `approval:review_requested`.
+ * - `submitApprovalDecision` also honors proposal-id prefixes containing
+ *   `expired`, `superseded`, `already-consumed`/`consumed`, `offline`,
+ *   `reject`, or `review`.
+ * - Repeated calls with the same `idempotency_key` return the identical
+ *   settled result (double-click safety).
+ *
+ * Replay progress is driven exclusively by `requestAnimationFrame`; this file
+ * intentionally contains no timer-based event generation.
+ */
+
+import type {
+  AgentRunEvent,
+  AgentRunFixture,
+  ApprovalState,
+  DataSource,
+  PulseState,
+  RecoveryProposal,
+} from "../types";
+import { HERMES_FIXTURES } from "./fixtures/hermesFixtures";
+import { ACTIVITIES, JOURNEY, PULSE, RECOVERY, TODAY_TIMELINE } from "./fixtures/journeyFixtures";
+import type {
+  AdapterMode,
+  ApprovalDecisionInput,
+  ApprovalDecisionResult,
+  CopilotMissionStart,
+  ExperienceAdapter,
+  MapState,
+  NormalizedAgentEvent,
+  NormalizedProposal,
+  NormalizedRun,
+  RecordedScenarioSummary,
+  RunEventHandlers,
+  RunSubscription,
+  RuntimeStatusInfo,
+  StopResult,
+} from "./contract";
+import type { RawAgentEvent } from "./normalize";
+import { EventStore, buildNormalizedRun } from "./eventStore";
+
+type RawEvent = RawAgentEvent;
+
+export const RECORDED_SCENARIO_KEYS = ["completed", "approved", "failed", "stopped"] as const;
+export type RecordedScenarioKey = (typeof RECORDED_SCENARIO_KEYS)[number];
+
+export interface RecordedRunSubscription extends RunSubscription {
+  stop: () => void;
+  whenComplete: () => Promise<void>;
+}
+
+function isRecordedScenarioKey(value: string): value is RecordedScenarioKey {
+  return (RECORDED_SCENARIO_KEYS as readonly string[]).includes(value);
+}
+
+function eventToRaw(event: AgentRunEvent, runId: string): RawEvent {
+  return {
+    id: event.id,
+    run_id: runId,
+    sequence_no: event.sequence_no,
+    event_type: event.event_type,
+    tool_name: event.tool_name,
+    timestamp: event.timestamp,
+    duration_ms: event.duration_ms,
+    approval_id: event.approval_id,
+    proposal_id: event.proposal_id,
+    summary: event.summary,
+    result: event.run_status ? { status: event.run_status } : undefined,
+    source: "HERMES_NATIVE",
+  };
+}
+
+/** Normalize a fixture into the runtime event contract under the given source. */
+export function normalizedFixtureEvents(
+  fixture: AgentRunFixture,
+  source: DataSource,
+): NormalizedAgentEvent[] {
+  const store = new EventStore({ source });
+  store.append(fixture.events.map((event) => eventToRaw(event, fixture.run_id)), {
+    source,
+    runId: fixture.run_id,
+  });
+  return store.snapshot();
+}
+
+function runFromFixture(key: RecordedScenarioKey, source: DataSource): NormalizedRun {
+  const fixture = HERMES_FIXTURES[key];
+  const events = normalizedFixtureEvents(fixture, source);
+  return buildNormalizedRun({
+    runId: fixture.run_id,
+    journeyId: JOURNEY.id,
+    runtimeIdentity: fixture.runtime_identity,
+    providerKey: fixture.provider_key,
+    modelKey: fixture.model_key,
+    events,
+    source,
+    lastUpdated: fixture.recorded_at,
+  });
+}
+
+const FIXTURE_STOP_COORDS: Record<string, [number, number]> = {
+  "act-morning-walk": [117.2005, 39.1168],
+  "act-river-cruise": [117.2108, 39.1264],
+  "act-market-window": [117.2163, 39.1322],
+  "act-museum": [117.2224, 39.1375],
+  "act-hotel": [117.228, 39.1402],
+  "act-departure": [117.2295, 39.1418],
+};
+
+/** Build the fixture map projection from `journeyFixtures` activities. */
+export function buildFixtureMapState(source: DataSource, lastUpdated: string): MapState {
+  const located = ACTIVITIES.filter((activity) => FIXTURE_STOP_COORDS[activity.id] !== undefined);
+  const coordinates = located.map((activity) => FIXTURE_STOP_COORDS[activity.id]);
+  const longitudes = coordinates.map((coordinate) => coordinate[0]);
+  const latitudes = coordinates.map((coordinate) => coordinate[1]);
+  const minLng = Math.min(...longitudes);
+  const maxLng = Math.max(...longitudes);
+  const minLat = Math.min(...latitudes);
+  const maxLat = Math.max(...latitudes);
+  return {
+    journey_id: JOURNEY.id,
+    route: {
+      type: "Feature",
+      properties: { provenance: "recorded-fixture://route-rain-003" },
+      geometry: { type: "LineString", coordinates },
+    },
+    stops: located.map((activity) => ({
+      id: activity.id,
+      name: activity.title.en,
+      coordinate: FIXTURE_STOP_COORDS[activity.id],
+      protected: activity.protected,
+    })),
+    bounds: [
+      [minLng, minLat],
+      [maxLng, maxLat],
+    ],
+    center: [(minLng + maxLng) / 2, (minLat + maxLat) / 2],
+    source,
+    last_updated: lastUpdated,
+  };
+}
+
+type ApprovalOutcome =
+  | "approved"
+  | "expired"
+  | "superseded"
+  | "already_consumed"
+  | "offline"
+  | "rejected"
+  | "review_requested";
+
+function outcomeFromProposalId(proposalId: string): ApprovalOutcome | null {
+  const value = proposalId.toLowerCase();
+  if (value.includes("expired")) return "expired";
+  if (value.includes("superseded")) return "superseded";
+  if (value.includes("already-consumed") || value.includes("already_consumed")) return "already_consumed";
+  if (value.includes("consumed")) return "already_consumed";
+  if (value.includes("offline")) return "offline";
+  if (value.includes("reject")) return "rejected";
+  if (value.includes("review")) return "review_requested";
+  return null;
+}
+
+/** Schedule one replay step. Uses rAF in browsers, microtasks in Node. */
+function scheduleFrame(callback: () => void): () => void {
+  if (typeof requestAnimationFrame === "function") {
+    const handle = requestAnimationFrame(() => callback());
+    return () => cancelAnimationFrame(handle);
+  }
+  let cancelled = false;
+  queueMicrotask(() => {
+    if (!cancelled) callback();
+  });
+  return () => {
+    cancelled = true;
+  };
+}
+
+export class RecordedFixtureAdapter implements ExperienceAdapter {
+  readonly mode: AdapterMode = "recorded";
+  readonly source: DataSource = "RECORDED_FIXTURE";
+
+  private scenarioKey: RecordedScenarioKey = "completed";
+  private approvalOutcomeOverride: ApprovalOutcome | null = null;
+  private readonly idempotencyResults = new Map<string, ApprovalDecisionResult>();
+  private readonly proposalResults = new Map<string, ApprovalDecisionResult>();
+
+  /** Select a recorded scenario or an approval-outcome override (see header). */
+  selectRecordedScenario(key: string): void {
+    if (isRecordedScenarioKey(key)) {
+      this.scenarioKey = key;
+      this.approvalOutcomeOverride = null;
+      return;
+    }
+    this.approvalOutcomeOverride = key.startsWith("approval:")
+      ? (key.slice("approval:".length) as ApprovalOutcome)
+      : (key as ApprovalOutcome);
+  }
+
+  listRecordedScenarios(): RecordedScenarioSummary[] {
+    return RECORDED_SCENARIO_KEYS.map((key) => {
+      const fixture = HERMES_FIXTURES[key];
+      return {
+        key,
+        label: fixture.scenario,
+        run_status: runFromFixture(key, this.source).status,
+        event_count: fixture.events.length,
+      };
+    });
+  }
+
+  async getJourneyPulse(): Promise<PulseState> {
+    return { ...PULSE, risk: { ...PULSE.risk, source: this.source } };
+  }
+
+  async getRuntimeStatus(): Promise<RuntimeStatusInfo> {
+    return {
+      identity: HERMES_FIXTURES[this.scenarioKey].runtime_identity,
+      status: "ready",
+      source: this.source,
+      last_updated: this.lastUpdated(),
+      detail: "Recorded fixture replay. No live Hermes run is executing.",
+    };
+  }
+
+  async getRecoveryDiff(proposalId?: string): Promise<RecoveryProposal | null> {
+    return {
+      ...RECOVERY,
+      proposal_id: proposalId ?? RECOVERY.proposal_id,
+      source: this.source,
+    };
+  }
+
+  async getMapState(): Promise<MapState> {
+    return buildFixtureMapState(this.source, this.lastUpdated());
+  }
+
+  async getTodayTimeline() {
+    return TODAY_TIMELINE.map((item) => ({ ...item, title: { ...item.title } }));
+  }
+
+  async startCopilotMission(input: { message: string; locale: "en" | "zh-CN" }): Promise<CopilotMissionStart> {
+    const wantsReplan = /replan|alternative|rain|swap|change|雨|替代|换/i.test(input.message);
+    const key = this.scenarioKey;
+    const run = runFromFixture(key, this.source);
+    return {
+      mission_id: `mission-fixture-${key}`,
+      run,
+      semantic_intent: wantsReplan ? "REQUEST_REPLAN" : "WHAT_IF",
+      answer: wantsReplan
+        ? "Recorded Hermes-style run selected. The timeline below replays recorded events only."
+        : "Preview only. The protected 09:30 cruise is unchanged and no mutation occurs.",
+      source: this.source,
+    };
+  }
+
+  async getRun(runId: string): Promise<NormalizedRun | null> {
+    const key = RECORDED_SCENARIO_KEYS.find((candidate) => HERMES_FIXTURES[candidate].run_id === runId);
+    return key ? runFromFixture(key, this.source) : null;
+  }
+
+  subscribeRunEvents(
+    runId: string,
+    handlers: RunEventHandlers,
+    options?: { since_sequence?: number },
+  ): RecordedRunSubscription {
+    const key =
+      RECORDED_SCENARIO_KEYS.find((candidate) => HERMES_FIXTURES[candidate].run_id === runId) ??
+      this.scenarioKey;
+    const fixture = HERMES_FIXTURES[key];
+    const allEvents = normalizedFixtureEvents(fixture, this.source);
+    const lastEventReceivedAt = fixture.recorded_at;
+    const since = options?.since_sequence ?? 0;
+    const replay = allEvents.filter((event) => event.sequence_no > since);
+
+    let lastSequence = since;
+    let index = 0;
+    let cancelled = false;
+    let cancelFrame: (() => void) | null = null;
+    let resolveComplete: () => void = () => undefined;
+    const completion = new Promise<void>((resolve) => {
+      resolveComplete = resolve;
+    });
+
+    const statusAt = (sequence: number): NormalizedRun =>
+      buildNormalizedRun({
+        runId: fixture.run_id,
+        journeyId: JOURNEY.id,
+        runtimeIdentity: fixture.runtime_identity,
+        providerKey: fixture.provider_key,
+        modelKey: fixture.model_key,
+        events: allEvents.filter((event) => event.sequence_no <= sequence),
+        source: this.source,
+        lastUpdated: lastEventReceivedAt,
+      });
+
+    handlers.onStatusChange?.(statusAt(since));
+
+    const step = () => {
+      if (cancelled) return;
+      if (index >= replay.length) {
+        resolveComplete();
+        return;
+      }
+      const event = replay[index];
+      index += 1;
+      lastSequence = Math.max(lastSequence, event.sequence_no);
+      handlers.onEvent(event);
+      handlers.onStatusChange?.(statusAt(lastSequence));
+      cancelFrame = scheduleFrame(step);
+    };
+    cancelFrame = scheduleFrame(step);
+
+    const stop = () => {
+      if (cancelled) return;
+      cancelled = true;
+      cancelFrame?.();
+      cancelFrame = null;
+      resolveComplete();
+    };
+
+    return {
+      unsubscribe: stop,
+      stop,
+      getLastSequence: () => lastSequence,
+      isLive: () => false,
+      whenComplete: () => completion,
+    };
+  }
+
+  async stopRun(runId: string): Promise<StopResult> {
+    return {
+      ok: true,
+      run_id: runId,
+      status: "stopped",
+      reason: "recorded replay stopped locally; no server event fabricated",
+      source: this.source,
+    };
+  }
+
+  async getProposal(proposalId?: string): Promise<NormalizedProposal | null> {
+    const id = proposalId ?? "proposal-fixture-002";
+    const settled = this.proposalResults.get(id);
+    let state: ApprovalState;
+    if (settled) state = settled.state;
+    else if (this.scenarioKey === "approved") state = "approved";
+    else if (this.scenarioKey === "completed") state = "approval_required";
+    else state = "proposal_only";
+    const approvalId =
+      id === "proposal-fixture-002" ? "approval-fixture-002" : settled?.approval_id;
+    return {
+      proposal_id: id,
+      journey_id: JOURNEY.id,
+      title: { ...RECOVERY.trigger },
+      state,
+      approval_id: approvalId,
+      source: this.source,
+      recovery: { ...RECOVERY, proposal_id: id, source: this.source },
+      last_updated: this.lastUpdated(),
+    };
+  }
+
+  async submitApprovalDecision(input: ApprovalDecisionInput): Promise<ApprovalDecisionResult> {
+    const cached = this.idempotencyResults.get(input.idempotency_key);
+    if (cached) return { ...cached };
+    const lastUpdated = new Date().toISOString();
+
+    if (!input.online) {
+      return this.settle(
+        input,
+        "approval_required",
+        "offline",
+        true,
+        "Offline: recorded approval is disabled until connectivity returns.",
+        lastUpdated,
+      );
+    }
+    if (input.decision === "reject") {
+      return this.settle(input, "rejected", undefined, false, "Recorded rejection settled. Current plan kept.", lastUpdated);
+    }
+    if (input.decision === "review_requested") {
+      return this.settle(
+        input,
+        "review_requested",
+        undefined,
+        true,
+        "Review requested. The recorded proposal returns to review.",
+        lastUpdated,
+      );
+    }
+
+    const outcome = this.approvalOutcomeOverride ?? outcomeFromProposalId(input.proposal_id);
+    switch (outcome) {
+      case "expired":
+        return this.settle(input, "approval_required", "expired", false, "Recorded approval expired. Refresh for a new proposal.", lastUpdated);
+      case "superseded":
+        return this.settle(input, "approval_required", "superseded", false, "Recorded proposal was superseded by newer truth.", lastUpdated);
+      case "already_consumed":
+        return this.settle(input, "approved", "already_consumed", false, "Recorded approval was already consumed; no new transition occurred.", lastUpdated);
+      case "offline":
+        return this.settle(input, "approval_required", "offline", true, "Offline: recorded approval is disabled until connectivity returns.", lastUpdated);
+      case "rejected":
+        return this.settle(input, "rejected", undefined, false, "Recorded rejection settled. Current plan kept.", lastUpdated);
+      case "review_requested":
+        return this.settle(input, "review_requested", undefined, true, "Review requested. The recorded proposal returns to review.", lastUpdated);
+      default:
+        return this.settle(
+          input,
+          "approved",
+          undefined,
+          false,
+          "Recorded approval accepted in reference mode. No backend mutation and no server truth claim.",
+          lastUpdated,
+        );
+    }
+  }
+
+  getLastUpdated(): string {
+    return this.lastUpdated();
+  }
+
+  private lastUpdated(): string {
+    return HERMES_FIXTURES[this.scenarioKey].recorded_at;
+  }
+
+  private settle(
+    input: ApprovalDecisionInput,
+    state: ApprovalState,
+    reason: ApprovalDecisionResult["reason"],
+    retryable: boolean,
+    message: string,
+    lastUpdated: string,
+  ): ApprovalDecisionResult {
+    const result: ApprovalDecisionResult = {
+      state,
+      server_truth: false,
+      proposal_id: input.proposal_id,
+      approval_id: input.approval_id,
+      reason,
+      retryable,
+      message,
+      last_updated: lastUpdated,
+    };
+    this.idempotencyResults.set(input.idempotency_key, result);
+    this.proposalResults.set(input.proposal_id, result);
+    return { ...result };
+  }
+}
