+  { id: "res-lunch", type: { en: "Lunch reservation", zh: "午餐预订" }, confirmation: "CNX-RECORDED-LUNCH-1240", status: "confirmed" },
+  { id: "res-hotel", type: { en: "Hotel check-in", zh: "酒店入住" }, confirmation: "CNX-RECORDED-HOTEL-1700", status: "protected" },
