+ * mutate PlanVersion, Gateway, Guardian, or any backend schema.
+ *
+ * 中文说明：本文件仅定义体验层的能力键与元数据，不修改后端 schema。
+ */
+
+export type CapabilityLocale = "en" | "zh-CN";
+
+export type LocalizedText = { en: string; zh: string };
