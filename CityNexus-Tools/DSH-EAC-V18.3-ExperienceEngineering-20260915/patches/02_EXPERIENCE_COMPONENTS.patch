+import type { LocalizedCopy } from "../types";
+
+export type Locale = "en" | "zh-CN";
+
+/** Pure UI helper: resolve display copy without importing fixture data. */
+export function pick(copy: LocalizedCopy, locale: Locale): string {
+  return locale === "zh-CN" ? copy.zh : copy.en;
+}
+
+export function isZh(locale: string): locale is "zh-CN" {
+  return locale === "zh-CN";
+}
diff --git a/frontend/src/features/experience-lab/features/accessibility/LiveRegion.tsx b/frontend/src/features/experience-lab/features/accessibility/LiveRegion.tsx
new file mode 100644
index 0000000..c4dd436
--- /dev/null
+++ b/frontend/src/features/experience-lab/features/accessibility/LiveRegion.tsx
@@ -0,0 +1,46 @@
+import type { CSSProperties } from "react";
+
+const VISUALLY_HIDDEN: CSSProperties = {
+  position: "absolute",
+  width: 1,
+  height: 1,
+  padding: 0,
+  margin: -1,
+  overflow: "hidden",
+  clip: "rect(0 0 0 0)",
+  whiteSpace: "nowrap",
+  border: 0,
+};
+
+/**
+ * Screen-reader live region.
+ *
+ * Default: `role="status"` + `aria-live="polite"`.
+ * `assertive` switches to `role="alert"` + `aria-live="assertive"` for
+ * genuinely urgent lifecycle transitions only.
+ *
+ * 中文说明：默认 polite；仅紧急生命周期变化使用 assertive。
+ */
+export function LiveRegion({
+  message,
+  assertive = false,
+  className,
+}: {
+  message: string;
+  assertive?: boolean;
+  className?: string;
+}) {
+  return (
+    <div
+      className={className ? `cnx-live-region ${className}` : "cnx-live-region"}
+      data-testid="live-region"
+      data-live-mode={assertive ? "assertive" : "polite"}
+      role={assertive ? "alert" : "status"}
+      aria-live={assertive ? "assertive" : "polite"}
+      aria-atomic="true"
+      style={VISUALLY_HIDDEN}
+    >
+      {message}
+    </div>
+  );
+}
diff --git a/frontend/src/features/experience-lab/features/accessibility/focus.ts b/frontend/src/features/experience-lab/features/accessibility/focus.ts
new file mode 100644
index 0000000..dcb9095
--- /dev/null
+++ b/frontend/src/features/experience-lab/features/accessibility/focus.ts
@@ -0,0 +1,103 @@
+/**
+ * Small dependency-free focus helpers for dialogs, sheets, and overlays.
+ * 中文说明：无外部依赖的焦点管理工具。
+ */
+
+export const FOCUSABLE_SELECTOR = [
+  "a[href]",
+  "button:not([disabled])",
+  "input:not([disabled]):not([type='hidden'])",
+  "select:not([disabled])",
+  "textarea:not([disabled])",
+  "summary:not(:disabled)",
+  "audio[controls]",
+  "video[controls]",
+  "[contenteditable='true']",
+  "[tabindex]:not([tabindex='-1'])",
+].join(",");
+
+function isFocusable(element: Element): boolean {
+  const html = element as HTMLElement;
+  if (typeof html.focus !== "function") return false;
+  if (html.hasAttribute("disabled")) return false;
+  if (html.getAttribute("aria-hidden") === "true") return false;
+  if (html.hidden) return false;
+  if (html.getAttribute("tabindex") === "-1" && html.getAttribute("contenteditable") !== "true") {
+    return false;
+  }
+  if (typeof window !== "undefined" && typeof window.getComputedStyle === "function") {
+    const style = window.getComputedStyle(html);
+    if (style.display === "none" || style.visibility === "hidden") return false;
+  }
+  return true;
+}
+
+/** Returns keyboard-focusable elements in document order. */
+export function getFocusable(
+  container: ParentNode | null | undefined,
+): HTMLElement[] {
+  if (!container) return [];
+  const nodes = container.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR);
+  return Array.from(nodes).filter(isFocusable);
+}
+
+/** Focuses the first focusable element and returns it, or `null` if none exist. */
+export function focusFirst(
+  container: ParentNode | null | undefined,
+): HTMLElement | null {
+  const first = getFocusable(container)[0] ?? null;
+  if (first) first.focus();
+  return first;
+}
+
+function containsNode(container: ParentNode, node: Element | null): boolean {
+  if (!node) return false;
+  const asNode = container as Node;
+  return typeof asNode.contains === "function" ? asNode.contains(node) : false;
+}
+
+/**
+ * Handles a Tab keydown event for a focus trap.
+ * Returns `true` when the event was handled and default navigation prevented.
+ */
+export function trapFocus(
+  container: ParentNode | null | undefined,
+  event: KeyboardEvent,
+): boolean {
+  if (!container || event.key !== "Tab") return false;
+  const focusable = getFocusable(container);
+  if (focusable.length === 0) return false;
+
+  const first = focusable[0];
+  const last = focusable[focusable.length - 1];
+  const active = typeof document !== "undefined" ? document.activeElement : null;
+  const activeElement =
+    active && typeof Element !== "undefined" && active instanceof Element ? active : null;
+
+  if (event.shiftKey) {
+    if (activeElement === first || !containsNode(container, activeElement)) {
+      event.preventDefault();
+      last.focus();
+      return true;
+    }
+    return false;
+  }
+
+  if (activeElement === last || !containsNode(container, activeElement)) {
+    event.preventDefault();
+    first.focus();
+    return true;
+  }
+  return false;
+}
+
+/** Restores focus when the element is still available. */
+export function restoreFocus(element: HTMLElement | null | undefined): boolean {
+  if (!element || typeof element.focus !== "function") return false;
+  try {
+    element.focus();
+    return true;
+  } catch {
+    return false;
+  }
+}
diff --git a/frontend/src/features/experience-lab/features/accessibility/useThrottledAnnouncer.ts b/frontend/src/features/experience-lab/features/accessibility/useThrottledAnnouncer.ts
new file mode 100644
index 0000000..5f9d235
--- /dev/null
+++ b/frontend/src/features/experience-lab/features/accessibility/useThrottledAnnouncer.ts
@@ -0,0 +1,156 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+
+/**
+ * Agent lifecycle transitions that must never be silently throttled away.
+ * 中文说明：这些关键生命周期变化必须可靠播报。
+ */
+export type AgentLifecycleTransition =
+  | "approval_required"
+  | "failed"
+  | "stopped"
+  | "completed";
+
+export const IMPORTANT_AGENT_TRANSITIONS: readonly AgentLifecycleTransition[] = [
+  "approval_required",
+  "failed",
+  "stopped",
+  "completed",
+];
+
+/** Maps raw agent event types to the important lifecycle vocabulary. */
+export const AGENT_EVENT_TO_TRANSITION: Record<string, AgentLifecycleTransition> = {
+  "approval.required": "approval_required",
+  "run.failed": "failed",
+  "run.stopped": "stopped",
+  "run.completed": "completed",
+};
+
+const IMPORTANT_TRANSITION_SET = new Set<string>(IMPORTANT_AGENT_TRANSITIONS);
+
+export function normalizeAgentTransition(
+  transition: string | null | undefined,
+): AgentLifecycleTransition | null {
+  if (!transition) return null;
+  if (IMPORTANT_TRANSITION_SET.has(transition)) {
+    return transition as AgentLifecycleTransition;
+  }
+  return AGENT_EVENT_TO_TRANSITION[transition] ?? null;
+}
+
+export function isImportantAgentTransition(
+  transition: string | null | undefined,
+): boolean {
+  return normalizeAgentTransition(transition) !== null;
+}
+
+export interface ThrottledAnnouncerOptions {
+  /** Minimum interval between ordinary announcements. Default: 1500 ms. */
+  minIntervalMs?: number;
+  /** Alias for `minIntervalMs`. */
+  minInterval?: number;
+  /** Optional initial live-region text. */
+  initialMessage?: string;
+}
+
+export interface AnnounceOptions {
+  /** Lifecycle transition, e.g. `approval_required` or `run.completed`. */
+  transition?: string | null;
+  /** Force the important path when the caller already classified the event. */
+  important?: boolean;
+}
+
+/** `announce(message)` or `announce(message, transition)` or `announce(message, options)`. */
+export type AnnounceArg = string | AnnounceOptions;
+
+export const DEFAULT_ANNOUNCEMENT_INTERVAL_MS = 1500;
+
+/**
+ * Throttles bursty agent events into a single live-region message while letting
+ * important lifecycle transitions through immediately.
+ *
+ * Only announcement coalescing uses `setTimeout`; progress is never fabricated.
+ */
+export function useThrottledAnnouncer(options: ThrottledAnnouncerOptions = {}) {
+  const minIntervalMs = Math.max(
+    0,
+    options.minIntervalMs ?? options.minInterval ?? DEFAULT_ANNOUNCEMENT_INTERVAL_MS,
+  );
+  const [message, setMessage] = useState(options.initialMessage ?? "");
+  const lastAnnouncedAt = useRef(0);
+  const hasAnnounced = useRef(false);
+  const trailing = useRef<string | null>(null);
+  const timer = useRef<number | null>(null);
+  const mounted = useRef(true);
+
+  const clearTimer = useCallback(() => {
+    if (timer.current != null) {
+      window.clearTimeout(timer.current);
+      timer.current = null;
+    }
+  }, []);
+
+  const flushTrailing = useCallback(() => {
+    timer.current = null;
+    const pending = trailing.current;
+    trailing.current = null;
+    if (!mounted.current || !pending) return;
+    setMessage(pending);
+    hasAnnounced.current = true;
+    lastAnnouncedAt.current = Date.now();
+  }, []);
+
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+      clearTimer();
+    };
+  }, [clearTimer]);
+
+  const announce = useCallback(
+    (text: string, arg?: AnnounceArg) => {
+      const trimmed = text.trim();
+      if (!trimmed) return;
+      const announceOptions: AnnounceOptions =
+        typeof arg === "string" ? { transition: arg } : arg ?? {};
+      const important =
+        announceOptions.important === true ||
+        isImportantAgentTransition(announceOptions.transition);
+
+      if (important) {
+        // Important lifecycle changes bypass the throttle. Calls in the same
+        // React batch collapse to the final lifecycle message.
+        trailing.current = null;
+        clearTimer();
+        if (!mounted.current) return;
+        setMessage(trimmed);
+        hasAnnounced.current = true;
+        lastAnnouncedAt.current = Date.now();
+        return;
+      }
+
+      const now = Date.now();
+      const elapsed = hasAnnounced.current
+        ? now - lastAnnouncedAt.current
+        : Number.POSITIVE_INFINITY;
+
+      if (timer.current == null && elapsed >= minIntervalMs) {
+        if (!mounted.current) return;
+        setMessage(trimmed);
+        hasAnnounced.current = true;
+        lastAnnouncedAt.current = now;
+        return;
+      }
+
+      // Burst coalescing: keep only the latest ordinary message.
+      trailing.current = trimmed;
+      if (timer.current == null) {
+        const wait = Math.max(0, minIntervalMs - elapsed);
+        timer.current = window.setTimeout(flushTrailing, wait);
+      }
+    },
+    [clearTimer, flushTrailing, minIntervalMs],
+  );
+
+  return { announce, message };
+}
diff --git a/frontend/src/features/experience-lab/features/capability/CapabilitySummary.tsx b/frontend/src/features/experience-lab/features/capability/CapabilitySummary.tsx
