+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  min-height: 44px;
+  width: 100%;
+  padding: 0 10px;
+  border: 0;
+  background: transparent;
+  color: var(--muted);
+  font-size: 0.68rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+
+.desktop-nav__group--system {
+  opacity: 0.82;
+  border-top: 1px dashed var(--line);
+  padding-top: 8px;
+}
+
+@media (max-width: 1023px) {
+  .journey-lower {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .app {
+    padding-bottom: env(safe-area-inset-bottom, 0px);
+  }
+
+  .bottom-nav {
+    padding-bottom: env(safe-area-inset-bottom, 0px);
+    height: calc(var(--nav-height) + env(safe-area-inset-bottom, 0px));
+  }
+
+  .sheet,
+  .copilot-panel {
+    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
+  }
+
+  .sheet {
+    bottom: calc(var(--nav-height) + env(safe-area-inset-bottom, 0px));
+  }
+
+  .copilot.is-collapsed {
+    bottom: calc(var(--nav-height) + 8px + env(safe-area-inset-bottom, 0px));
+  }
+}
+
+.timeline__summary {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  flex-wrap: wrap;
+  border-top: 1px dashed var(--line);
+  padding-top: 8px;
+}
+
+@media (max-width: 1023px) {
+  .sheet {
+    bottom: calc(var(--nav-height) + 76px + env(safe-area-inset-bottom, 0px));
+  }
+
+  .sheet__content {
+    padding-bottom: 16px;
+  }
+}
diff --git a/frontend/src/features/experience-lab/styles/global.css b/frontend/src/features/experience-lab/styles/global.css
new file mode 100644
index 0000000..52ae830
--- /dev/null
+++ b/frontend/src/features/experience-lab/styles/global.css
@@ -0,0 +1,65 @@
+/**
+ * V18.3 global document rules only. Component rules live in experience.css
+ * under @scope(.citynexus-experience) so the reference UI cannot leak into the
+ * host CityNexus stylesheet.
+ */
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html,
+body,
+#root {
+  min-height: 100%;
+}
+
+body {
+  margin: 0;
+  color: var(--text, #eaf6f4);
+  background: var(--bg, #071217);
+  font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, sans-serif;
+  overflow-x: hidden;
+}
+
+::view-transition-old(root) {
+  animation: cn-route-out var(--cn-motion-fast, 160ms) ease both;
+}
+
+::view-transition-new(root) {
+  animation: cn-route-in var(--cn-motion-base, 220ms) var(--cn-ease-enter, cubic-bezier(0.16, 1, 0.3, 1)) both;
+}
+
+@keyframes cn-route-out {
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes cn-route-in {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.001ms !important;
+    scroll-behavior: auto !important;
+  }
+
+  ::view-transition-old(root),
+  ::view-transition-new(root) {
+    animation: none !important;
+  }
+}
