+  color: var(--accent-strong);
+}
+
+.runtime-demo {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.sheet-state {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.sheet-state h3 {
