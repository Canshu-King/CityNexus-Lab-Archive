+#: Deterministic ring offsets, in degrees, so template POIs do not stack on the
+#: city centre (and never on Null Island).
+_RING_OFFSETS: tuple[tuple[float, float], ...] = (
+    (0.006, 0.008),
+    (-0.011, 0.005),
+    (0.004, -0.013),
+    (-0.008, -0.009),
+    (0.014, 0.001),
+    (-0.003, 0.015),
