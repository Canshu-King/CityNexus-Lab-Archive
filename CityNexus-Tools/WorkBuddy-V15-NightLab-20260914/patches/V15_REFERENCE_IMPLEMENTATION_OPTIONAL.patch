+    "prefer museums", "avoid anything", "no more walking", "only got",
+    "我想", "想看", "当地文化", "不想要", "需要预约", "不用预约",
+    "too packed", "loosen",
+)
+
+REPLAN = (
+    "重新安排", "重新排", "重新规划", "重排", "改到", "改成", "换成", "换到",
+    "调换", "调整", "取消", "退票", "付款", "订", "预订", "压缩", "提前",
+    "改一下", "帮我改", "重新安排一下", "不动已经订好", "别动已经",
+    "迟到", "赶得上", "还来得及", "撞了", "冲突", "太紧", "松一点",
+    "保预算", "省钱", "不想取消", "先保",
