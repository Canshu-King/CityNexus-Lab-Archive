+CHANGE_VERB = (
+    "改", "换", "调", "重新", "压缩", "提前", "取消", "退",
+    "move", "change", "swap", "drop", "reorder", "rearrange",
+    "reschedule", "compress", "cancel", "refund", "book", "pay",
+)
