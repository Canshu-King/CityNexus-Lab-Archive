+#: replan marker is also present, so a bare preference cannot become a rewrite.
+REPLAN_PREFERENCE_COLLISIONS = ("省钱",)
+
+# Anything that touches money or a fixed commitment needs a human gate.
+HIGH_IMPACT = (
+    "取消", "退票", "退款", "付款", "支付", "订", "预订", "花", "购买",
