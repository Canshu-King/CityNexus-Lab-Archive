+        severity="HIGH",
+        at="2026-10-10T03:00:00+00:00",
+        valid_until="2026-10-10T04:00:00+00:00",
+        provider_key="open-meteo",
+        evidence={"precipitation_probability": 90},
+        scope=WeatherQueryScope(place.id, place.latitude, place.longitude),
+    )
+    assert (
