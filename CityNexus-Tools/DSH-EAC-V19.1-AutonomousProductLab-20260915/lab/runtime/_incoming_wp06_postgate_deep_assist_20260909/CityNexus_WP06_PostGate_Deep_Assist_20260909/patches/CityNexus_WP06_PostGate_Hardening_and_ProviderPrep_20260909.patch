+from __future__ import annotations
+
+from app.integrations.ai.base import AIProvider, AITextResult
+from app.integrations.ai.fallback import DeterministicFallbackAIProvider
+from app.intelligence.reason_codes import VerifiedExplanationFacts
+
+
+class ResilientAIExplanationService:
+    """Use an optional real LLM without making it authoritative or mandatory."""
+
+    def __init__(
+        self,
+        *,
+        primary: AIProvider | None,
+        fallback: AIProvider | None = None,
+    ) -> None:
+        self._primary = primary
+        self._fallback = fallback or DeterministicFallbackAIProvider()
+
+    async def explain(self, facts: VerifiedExplanationFacts, *, task: str) -> AITextResult:
+        if self._primary is not None:
+            try:
+                result = await self._primary.explain(facts, task=task)
+                if result.text.strip():
+                    return result
+            except Exception:  # external LLM boundary: deterministic fallback is intentional
+                pass
+        return await self._fallback.explain(facts, task=task)
--- a/backend/app/integrations/mobility/snapshot_capture.py
+++ b/backend/app/integrations/mobility/snapshot_capture.py
@@ -0,0 +1,98 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Iterable, Protocol
+
+from app.replanning.provider_snapshots import MobilitySnapshot, TravelEstimateFact
+
+
+class MinuteEstimator(Protocol):
+    provider_key: str
+
+    def estimate_minutes(self, origin_key: str, destination_key: str) -> int: ...
+
+
+class MobilitySnapshotCaptureError(RuntimeError):
+    pass
+
+
+@dataclass(frozen=True)
+class MobilitySnapshotCaptureResult:
+    snapshot: MobilitySnapshot
+    failed_primary_pairs: tuple[tuple[str, str], ...]
+    fallback_pairs: tuple[tuple[str, str], ...]
+
+    @property
+    def degraded(self) -> bool:
+        return self.snapshot.degraded
+
+
+def capture_mobility_snapshot(
+    pairs: Iterable[tuple[str, str]],
+    *,
+    primary: MinuteEstimator,
+    fallback: MinuteEstimator | None = None,
+    captured_at: str | None = None,
+) -> MobilitySnapshotCaptureResult:
+    """Capture external mobility facts before the deterministic feasibility gate.
+
+    The function deliberately performs provider calls outside the gate and freezes
+    their results into ``MobilitySnapshot``. If the primary provider fails for a
+    pair, an explicit fallback may fill that pair; the resulting snapshot is then
+    marked degraded and every fact retains its own provider provenance.
+    """
+
+    stamp = captured_at or datetime.now(timezone.utc).isoformat()
+    normalized_pairs = tuple(sorted(set((str(a), str(b)) for a, b in pairs if a and b)))
+    facts: dict[tuple[str, str], TravelEstimateFact] = {}
+    primary_failures: list[tuple[str, str]] = []
+    fallback_pairs: list[tuple[str, str]] = []
+
+    for origin, destination in normalized_pairs:
+        try:
+            minutes = int(primary.estimate_minutes(origin, destination))
+            if minutes < 0:
+                raise ValueError("negative travel minutes")
+            provider_key = str(primary.provider_key)
+            degraded = False
+        except Exception as primary_exc:  # external-provider boundary
+            primary_failures.append((origin, destination))
+            if fallback is None:
+                raise MobilitySnapshotCaptureError(
+                    f"mobility fact unavailable for {origin}|{destination}: "
+                    f"{type(primary_exc).__name__}"
+                ) from primary_exc
+            try:
+                minutes = int(fallback.estimate_minutes(origin, destination))
+                if minutes < 0:
+                    raise ValueError("negative fallback travel minutes")
+            except Exception as fallback_exc:  # external-provider boundary
+                raise MobilitySnapshotCaptureError(
+                    f"primary and fallback mobility facts unavailable for "
+                    f"{origin}|{destination}"
+                ) from fallback_exc
+            provider_key = str(fallback.provider_key)
+            degraded = True
+            fallback_pairs.append((origin, destination))
+
+        facts[(origin, destination)] = TravelEstimateFact(
+            origin_key=origin,
+            destination_key=destination,
+            minutes=minutes,
+            provider_key=provider_key,
+            captured_at=stamp,
+            degraded=degraded,
+        )
+
+    snapshot = MobilitySnapshot(
+        facts=facts,
+        source_provider_key=str(primary.provider_key),
+        captured_at=stamp,
+        degraded=bool(primary_failures),
+    )
+    return MobilitySnapshotCaptureResult(
+        snapshot=snapshot,
+        failed_primary_pairs=tuple(primary_failures),
+        fallback_pairs=tuple(fallback_pairs),
+    )
--- a/backend/app/integrations/mobility/valhalla_http.py
+++ b/backend/app/integrations/mobility/valhalla_http.py
@@ -0,0 +1,106 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Any, Callable, Mapping
+
+import httpx
+
+
+@dataclass(frozen=True)
+class ValhallaRouteEstimate:
+    duration_min: int
+    distance_m: int | None
+    shape: str | None
+    raw: dict[str, Any]
+
+
+class ValhallaHTTPMobilityProvider:
+    """Thin injectable adapter for a Valhalla HTTP service.
+
+    It is intentionally independent of the deterministic feasibility gate. Route
+    or matrix results should be frozen through ``capture_mobility_snapshot``
+    before the gate consumes them.
+    """
+
+    provider_key = "valhalla-http"
+
+    def __init__(
+        self,
+        *,
+        client: httpx.Client,
+        base_url: str,
+        place_lookup: Callable[[str], Mapping[str, Any]],
+        costing: str = "pedestrian",
+    ) -> None:
+        self._client = client
+        self._base_url = base_url.rstrip("/")
+        self._place_lookup = place_lookup
+        self._costing = costing
+
+    def _location(self, place_id: str) -> dict[str, float]:
+        item = self._place_lookup(place_id)
+        location = item.get("location", item)
+        return {"lat": float(location["latitude"]), "lon": float(location["longitude"])}
+
+    def estimate(self, origin_place_id: str, destination_place_id: str) -> ValhallaRouteEstimate:
+        response = self._client.post(
+            f"{self._base_url}/route",
+            json={
+                "locations": [
+                    self._location(origin_place_id),
+                    self._location(destination_place_id),
+                ],
+                "costing": self._costing,
+                "units": "kilometers",
+            },
+        )
+        response.raise_for_status()
+        payload = response.json()
+        trip = payload.get("trip") or {}
+        summary = trip.get("summary") or {}
+        seconds = float(summary["time"])
+        if seconds < 0:
+            raise ValueError("Valhalla returned negative route time")
+        length_km = summary.get("length")
+        legs = trip.get("legs") or []
+        shape = legs[0].get("shape") if legs and isinstance(legs[0], dict) else None
+        return ValhallaRouteEstimate(
+            duration_min=max(0, math.ceil(seconds / 60.0)),
+            distance_m=None if length_km is None else round(float(length_km) * 1000),
+            shape=shape,
+            raw=payload,
+        )
+
+    def estimate_minutes(self, origin_place_id: str, destination_place_id: str) -> int:
+        return self.estimate(origin_place_id, destination_place_id).duration_min
+
+    def matrix_minutes(self, place_ids: list[str]) -> list[list[int | None]]:
+        locations = [self._location(place_id) for place_id in place_ids]
+        response = self._client.post(
+            f"{self._base_url}/sources_to_targets",
+            json={
+                "sources": locations,
+                "targets": locations,
+                "costing": self._costing,
+                "verbose": False,
+            },
+        )
+        response.raise_for_status()
+        payload = response.json()
+        raw = payload.get("durations")
+        if raw is None and isinstance(payload.get("sources_to_targets"), dict):
+            raw = payload["sources_to_targets"].get("durations")
+        if not isinstance(raw, list):
+            raise ValueError("Valhalla matrix response does not contain durations")
+        matrix: list[list[int | None]] = []
+        for row in raw:
+            if not isinstance(row, list):
+                raise ValueError("Valhalla matrix durations must be row-major")
+            matrix.append(
+                [
+                    None if value is None else max(0, math.ceil(float(value) / 60.0))
+                    for value in row
+                ]
+            )
+        return matrix
