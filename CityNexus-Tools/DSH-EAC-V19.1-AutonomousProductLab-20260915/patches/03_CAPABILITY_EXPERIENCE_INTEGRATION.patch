+        </div>
+      ) : null}
+
+      <button type="button" className="cne-button cne-button--primary cne-mobile-shield__action" onClick={onPrimaryAction} data-testid="mobile-shield-action">
+        {model.primaryActionLabel || copy.mobile.primaryAction}
+      </button>
+    </section>
+  );
+}
