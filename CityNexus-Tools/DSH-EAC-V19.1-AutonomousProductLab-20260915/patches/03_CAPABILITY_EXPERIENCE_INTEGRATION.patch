+@app.get("/api/v1/journeys/{journey_id}/capability-plan-impact")
+def get_capability_plan_impact(
+    journey_id: UUID,
+    plan_version_id: str | None = Query(default=None),
+    session: Session = Depends(get_session),
+):
+    """Expose actual deterministic gate failures as capability impacts.
+
+    The endpoint does not invent an accessibility claim.  When a PlanVersion
+    has no frozen mobility evidence, it returns CONTRACT_NOT_AVAILABLE instead
+    of producing a softened "preserved" result.
+    """
+
+    journey = require(session, Journey, str(journey_id), "Journey")
+    if plan_version_id:
+        plan = session.scalar(
+            select(PlanVersion).where(
+                PlanVersion.id == plan_version_id,
+                PlanVersion.journey_id == journey.id,
+            )
+        )
+    elif journey.active_plan_version_id:
+        plan = session.get(PlanVersion, journey.active_plan_version_id)
+    else:
+        plan = session.scalar(
+            select(PlanVersion)
+            .where(PlanVersion.journey_id == journey.id)
+            .order_by(PlanVersion.version_no.desc())
+        )
+    capabilities = capability_payload(session, journey.traveler_id, journey.id)
+    if plan is None:
+        return {
+            "journey_id": journey.id,
+            "status": "CONTRACT_NOT_AVAILABLE",
+            "reason": "NO_PLAN_VERSION",
+            "capabilities": capabilities,
+            "impacts": None,
+            "unknown_accessibility_is_not_accessible": True,
+        }
+    activities = session.scalars(
+        select(Activity)
+        .where(Activity.plan_version_id == plan.id)
+        .order_by(Activity.sequence_no)
+    ).all()
+    evidence_payload = json.loads(plan.mobility_evidence_json or "{}")
+    failures: list[str] = []
+    gate_status = "PASS"
+    if not evidence_payload.get("snapshot_id"):
+        gate_status = "CONTRACT_NOT_AVAILABLE"
+        failures = ["PLAN_EVIDENCE_UNAVAILABLE"]
+    else:
+        try:
+            selection_snapshot = MobilitySnapshot.from_evidence(evidence_payload)
+            constraints = _journey_constraints_with_capabilities(session, journey, active_only=True)
+            places = {
+                place.id: place
+                for place in session.scalars(
+                    select(Place).where(Place.city_code == journey.city_code)
+                ).all()
+            }
+            services = {
+                service.id: service
+                for service in session.scalars(
+                    select(CityService).where(CityService.city_code == journey.city_code)
+                ).all()
+            }
+            gate = evaluate_feasibility(
+                build_context(
+                    journey,
+                    constraints,
+                    places,
+                    services,
+                    mobility_provider=selection_snapshot,
+                    plan_currency=plan.currency,
+                ),
+                [activity_from_record(item) for item in activities],
+            )
+            failures = list(gate.failures)
+            gate_status = "PASS" if gate.passed else "FAIL"
+        except Exception as exc:  # noqa: BLE001 - expose contract evidence state, not a crash
+            gate_status = "CONTRACT_NOT_AVAILABLE"
+            failures = [f"PLAN_EVIDENCE_ERROR:{type(exc).__name__}"]
+    impacts = build_capability_impacts(capabilities, failures, candidate_id=plan.id)
+    return {
+        "journey_id": journey.id,
+        "plan_version_id": plan.id,
+        "status": gate_status,
+        "gate_failures": failures,
+        "capabilities": capabilities,
+        "impacts": impacts,
+        "unknown_accessibility_is_not_accessible": True,
+    }
+
+
 @app.get("/api/v1/travelers/{traveler_id}/traveler-twin")
 def get_traveler_twin(traveler_id: UUID, session: Session = Depends(get_session)):
     traveler = require(session, Traveler, str(traveler_id), "Traveler")
