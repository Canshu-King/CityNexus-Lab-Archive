+                onClick={() => toggleQuick(need.id)}
+              >
+                <span className="cne-chip__mark" aria-hidden="true">{selected ? "✓" : "+"}</span>
+                <span>{locale === "zh-CN" ? need.labelZh : need.labelEn}</span>
+              </button>
+            );
+          })}
+        </div>
+      </fieldset>
+
+      <div className="cne-setup__advanced">
+        <button
+          type="button"
+          className="cne-disclosure"
