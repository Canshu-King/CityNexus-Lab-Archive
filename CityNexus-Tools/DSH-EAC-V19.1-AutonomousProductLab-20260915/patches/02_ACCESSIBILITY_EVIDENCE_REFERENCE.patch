+def _parse_accessibility_place_tags(place: Any) -> dict[str, Any]:
+    """Read only provider/frozen tags that actually exist on the place."""
+
+    merged: dict[str, Any] = {}
+    try:
+        metadata = json.loads(place.metadata_json or "{}")
+    except (TypeError, ValueError):
+        metadata = {}
+    if isinstance(metadata, Mapping):
+        nested = metadata.get("accessibility") or metadata.get("accessibility_evidence")
+        if isinstance(nested, Mapping):
+            merged.update({str(key): value for key, value in nested.items()})
+        tags = metadata.get("tags")
+        if isinstance(tags, Mapping):
+            merged.update({str(key): value for key, value in tags.items()})
+    try:
+        raw_tags = json.loads(place.tags_json or "[]")
+    except (TypeError, ValueError):
+        raw_tags = []
+    if isinstance(raw_tags, Mapping):
+        merged.update({str(key): value for key, value in raw_tags.items()})
+    elif isinstance(raw_tags, (list, tuple)):
+        for raw in raw_tags:
+            if isinstance(raw, str) and "=" in raw:
+                key, value = raw.split("=", 1)
+                merged[key.strip()] = value.strip()
+    return merged
+
+
+def _overall_accessibility_state(items: list[dict[str, Any]]) -> str:
+    return overall_accessibility_state(items)
+
+
+@app.get("/api/v1/places/{place_id}/accessibility-evidence")
+def get_place_accessibility_evidence(place_id: str, session: Session = Depends(get_session)):
