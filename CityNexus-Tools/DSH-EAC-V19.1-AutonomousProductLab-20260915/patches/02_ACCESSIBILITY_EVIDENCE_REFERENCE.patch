+    facts = evidence_from_osm_tags(
+        _parse_accessibility_place_tags(place),
+        provider=place.provider_key or "citynexus",
+        source_key=place.external_id or place.id,
+        place_id=place.id,
+        city_code=place.city_code,
+    )
+    items = [fact.as_dict() for fact in facts]
+    return {
+        "place_id": place.id,
+        "place_name": place.name,
+        "city_code": place.city_code,
+        "provider": place.provider_key,
+        "source_key": place.external_id or place.id,
+        "captured_at": items[0]["captured_at"] if items else None,
+        "items": items,
+        "overall_state": _overall_accessibility_state(items),
+        "unknown_is_not_accessible": True,
+    }
+
+
+@app.get("/api/v1/journeys/{journey_id}/accessibility-evidence")
+def get_journey_accessibility_evidence(journey_id: UUID, session: Session = Depends(get_session)):
+    journey = require(session, Journey, str(journey_id), "Journey")
+    activity_rows = session.scalars(
+        select(Activity)
+        .join(PlanVersion, Activity.plan_version_id == PlanVersion.id)
+        .where(PlanVersion.journey_id == journey.id)
+        .order_by(Activity.sequence_no)
+    ).all()
+    items: list[dict[str, Any]] = []
+    place_ids: set[str] = set()
+    for activity in activity_rows:
+        if not activity.place_id or activity.place_id in place_ids:
+            continue
+        place_ids.add(activity.place_id)
+        place = session.get(Place, activity.place_id)
+        if place is None:
+            continue
+        facts = evidence_from_osm_tags(
+            _parse_accessibility_place_tags(place),
+            provider=place.provider_key or "citynexus",
+            source_key=place.external_id or place.id,
+            place_id=place.id,
+            city_code=place.city_code,
+        )
+        items.extend({**fact.as_dict(), "activity_id": activity.id} for fact in facts)
+    # Route-level step-free evidence is not owned by the current provider
+    # contract.  Surface that gap explicitly rather than inferring from distance.
+    items.append(
+        {
+            "state": "NEEDS_LIVE_EVIDENCE",
+            "code": "ROUTE_STEP_FREE",
+            "subject": "ROUTE",
+            "summary": "Route-level step-free evidence is not available from the current provider contract.",
+            "raw": {"key": None, "value": None},
+            "provider": "citynexus",
+            "source_key": f"journey:{journey.id}",
+            "place_id": None,
+            "city_code": journey.city_code,
+            "captured_at": datetime.now(timezone.utc).isoformat(),
+            "confidence_type": "contract_gap",
+            "provenance": {"journey_id": journey.id, "contract_gap": "ROUTE_STEP_FREE"},
+        }
+    )
+    return {
+        "journey_id": journey.id,
+        "city_code": journey.city_code,
+        "items": items,
+        "overall_state": _overall_accessibility_state(items),
+        "unknown_is_not_accessible": True,
+    }
+
