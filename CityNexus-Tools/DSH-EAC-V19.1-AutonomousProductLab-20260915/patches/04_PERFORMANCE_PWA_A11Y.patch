+.cne-shadow-experience { display: grid; gap: 1rem; }
+.cne-shadow-controls { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: end; background: #fff; border: 1px solid #c9d6d3; border-radius: 16px; padding: 0.75rem; }
+.cne-shadow-controls label { display: grid; gap: 0.2rem; font-weight: 700; font-size: 0.82rem; }
+.cne-shadow-controls input { min-height: 40px; border: 1px solid #c9d6d3; border-radius: 10px; padding: 0.45rem 0.55rem; font: inherit; min-width: 16rem; }
+.cne-shadow-source { border-radius: 14px; padding: 0.75rem; display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
+.cne-shadow-source--live_shadow { background: #eef7ff; border: 2px solid #9ccbe8; }
+.cne-shadow-source--recorded_fixture { background: #fff8e8; border: 2px solid #e8c56a; }
+.cne-shadow-source--offline_stale { background: #fff4e6; border: 2px solid #e09c4c; }
+.cne-shadow-source p, .cne-shadow-source ul { flex-basis: 100%; margin: 0.2rem 0 0; }
+.cne-shadow-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; align-items: start; }
+.cne-shadow-grid > section { display: grid; gap: 0.6rem; }
+.cne-shadow-grid h2 { font-size: 1.05rem; margin: 0; }
+.cne-mobile-frame { width: min(430px, 100%); border: 8px solid #17383d; border-radius: 28px; background: #fff; padding: 0.65rem; }
