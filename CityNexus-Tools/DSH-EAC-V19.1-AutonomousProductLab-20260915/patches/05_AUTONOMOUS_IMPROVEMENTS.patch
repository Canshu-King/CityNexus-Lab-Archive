+@app.get("/api/v1/capabilities/catalog")
+def get_capability_catalog() -> dict[str, Any]:
+    """Expose the canonical capability vocabulary to UI/Copilot clients.
+
+    The catalog is descriptive only; it does not imply provider evidence or
+    planning outcomes.
+    """
+
+    return {
+        "codes": [
+            {
+                "code": code,
+                "class": capability_class_for(code),
+                "default_severity": default_severity(code, hard_asserted=False),
+                "hard_accessibility": code in {"STEP_FREE_REQUIRED", "AVOID_STAIRS"},
+            }
+            for code in CAPABILITY_CODES
+        ],
+        "classes": list(CAPABILITY_CLASSES),
+        "severities": list(CAPABILITY_SEVERITIES),
