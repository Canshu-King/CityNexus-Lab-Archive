+@app.post("/api/v1/travelers/{traveler_id}/capabilities/extract")
+def extract_traveler_capabilities(
+    traveler_id: UUID,
+    payload: CapabilityExtractRequest,
+    session: Session = Depends(get_session),
+):
+    """Return bounded capability candidates from text without persistence.
+
+    This endpoint exists for setup/Copilot confirmation UX.  It never creates
+    provider evidence and never persists a HARD need silently.
+    """
+
+    traveler = require(session, Traveler, str(traveler_id), "Traveler")
+    candidates = extract_capabilities_from_text(
+        payload.text,
+        scope=payload.scope,
+        source="TEXT_EXTRACTION",
+        provenance="USER_STATED",
+    )
+    return {
+        "traveler_id": traveler.id,
+        "text": payload.text,
+        "scope": payload.scope,
+        "candidates": list(candidates),
+        "source": "DETERMINISTIC_TEXT_FALLBACK",
+        "authority": "UI_CANDIDATE_ONLY",
+        "unknown_accessibility_is_not_accessible": True,
+    }
+
+
+@app.get("/api/v1/travelers/{traveler_id}/capabilities/audit")
+def list_capability_audit(
+    traveler_id: UUID,
+    limit: int = Query(default=50, ge=1, le=200),
+    session: Session = Depends(get_session),
+):
+    """Inspect capability change history without exposing secrets."""
+
+    traveler = require(session, Traveler, str(traveler_id), "Traveler")
+    rows = session.scalars(
+        select(AuditLog)
+        .where(
+            AuditLog.actor_id == traveler.id,
+            AuditLog.entity_type == "TravelerCapability",
+        )
+        .order_by(AuditLog.created_at.desc(), AuditLog.id.desc())
+        .limit(limit)
+    ).all()
+    return {
+        "traveler_id": traveler.id,
+        "events": [
+            {
+                "id": row.id,
+                "action": row.action,
+                "journey_id": row.journey_id,
+                "entity_id": row.entity_id,
+                "before": json.loads(row.before_json) if row.before_json else None,
+                "after": json.loads(row.after_json) if row.after_json else None,
+                "created_at": row.created_at,
+            }
+            for row in rows
+        ],
+    }
 
 
