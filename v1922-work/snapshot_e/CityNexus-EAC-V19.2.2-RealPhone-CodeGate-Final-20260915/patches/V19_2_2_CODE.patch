+    """True when a key is a structural anchor identity rather than a chosen POI."""
+
+    key = str(value or "").strip()
+    if not key:
+        return False
+    if key in LEGACY_STRUCTURAL_KEYS or key in set(STRUCTURAL_ANCHOR_KEYS.values()):
