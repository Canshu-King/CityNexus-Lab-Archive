+    unresolved = not semantic_key
+    return AnchorIdentity(
+        role=role,
+        semantic_key=semantic_key,
+        place_id=place_id,
+        scheduled_start_at=str(policy.get("scheduled_start_at") or ""),
+        time_boundary=time_boundary_for(role),
