+def _remap_commitment_to_active_plan(session: Session, commitment: Commitment) -> None:
+    """Keep a booking commitment addressable after a concurrent replan.
+
+    ``activity_id`` is PlanVersion-local.  A capture that arrives after an
+    accept must either move the commitment to the equivalent activity on the
+    now-active plan or fail closed; it must never promote a stale pointer to
+    C4 truth.
+    """
+
+    journey = session.get(Journey, commitment.journey_id)
+    if journey is None or not journey.active_plan_version_id or not commitment.activity_id:
+        return
+    current = session.get(Activity, commitment.activity_id)
+    if current is None or current.plan_version_id == journey.active_plan_version_id:
+        return
+    policy = json.loads(commitment.policy_json or "{}")
+    wanted = {
+        str(policy.get("semantic_key") or ""),
+        str(policy.get("semantic_node_key") or ""),
+        str(current.place_id or ""),
+        str(current.city_service_id or ""),
+    }
+    wanted = {item for item in wanted if item}
+    scheduled_start = str(policy.get("scheduled_start_at") or "")
+    boundary = "END" if str(policy.get("anchor_role") or "").upper() == "DEPARTURE" else "START"
+    candidates = session.scalars(
+        select(Activity).where(Activity.plan_version_id == journey.active_plan_version_id)
+    ).all()
+    for candidate in candidates:
+        metadata = json.loads(candidate.metadata_json or "{}")
+        tokens = {
+            str(candidate.place_id or ""),
+            str(candidate.city_service_id or ""),
+            str(metadata.get("semantic_key") or ""),
+            str(metadata.get("semantic_node_key") or ""),
+        }
+        moment = candidate.end_at if boundary == "END" else candidate.start_at
+        if wanted.intersection(tokens) and scheduled_start and moment:
+            try:
+                if datetime.fromisoformat(moment) == datetime.fromisoformat(scheduled_start):
+                    commitment.activity_id = candidate.id
+                    return
+            except ValueError:
+                continue
+    raise CommerceConflict("captured booking cannot be attached to the active Journey plan")
+
