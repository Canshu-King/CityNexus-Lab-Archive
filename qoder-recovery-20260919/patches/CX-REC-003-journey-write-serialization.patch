 def _accept_replan_impl(
+    proposal_id: UUID,
+    idempotency_key: str | None,
+    session: Session,
+    **audit_context: Any,
+):
+    """Serialize Journey-scoped acceptance before validating mutable state."""
+
+    from app.concurrency_guards import journey_write_lock
+
+    journey_id = session.scalar(
+        select(ReplanProposalModel.journey_id).where(
+            ReplanProposalModel.id == str(proposal_id)
+        )
+    )
+    if journey_id is None:
+        raise HTTPException(404, f"Replan proposal {proposal_id} was not found")
+    with journey_write_lock(str(journey_id)):
+        # The proposal may have changed while this request waited for the lock;
+        # expire the identity map so all validation below observes committed
+        # authoritative state from the preceding writer.
+        session.expire_all()
+        return _accept_replan_serialized_impl(
+            proposal_id,
+            idempotency_key,
+            session,
+            **audit_context,
+        )
